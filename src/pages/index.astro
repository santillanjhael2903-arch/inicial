                                <span class="absolute left-1/3 bottom-1 w-5 h-5 rounded-full border border-cyan-200 bg-cyan-100/60 animate-bubble-float" style="animation-delay: 0.15s"></span>
                                <span class="absolute right-8 bottom-0 w-3.5 h-3.5 rounded-full border border-cyan-200 bg-cyan-100/60 animate-bubble-float" style="animation-delay: 0.3s"></span>
                            </div>
                        </div>

                        <!-- Letras blancas con fondo destacado -->
                        <div class="flex flex-col items-center gap-1 w-full">
                            <span class="font-black text-xs sm:text-sm text-white bg-emerald-600 px-3.5 py-1 rounded-full shadow-md flex items-center justify-center gap-1 w-full">
                                ✨ Río Limpio
                            </span>
                            <span class="text-[10px] sm:text-xs font-black text-white bg-emerald-800/90 px-3 py-0.5 rounded-full shadow-xs">
                                ¡Peces felices y agua clara!
                            </span>
                        </div>
                    </button>

                    <!-- Opción B: Río Sucio -->
                    <button id="m2-dirty" class="group relative flex-1 max-w-[215px] sm:max-w-[245px] w-full bg-white/90 rounded-3xl p-3 border-4 border-slate-300 shadow-md transition-all duration-300 cursor-pointer flex flex-col items-center text-center active:scale-95 card-tactil-kids">
                        <div class="w-full h-28 sm:h-36 rounded-2xl overflow-hidden mb-2.5 bg-amber-100 border-2 border-slate-300 relative shadow-inner">
                            <img id="m2-dirty-img" src="/images/${encodeURIComponent('juego 2 RIO SUCIO.jpeg')}" alt="Río sucio" class="w-full h-full object-cover object-center transition-all duration-300">

                            <!-- Partículas semitransparentes en suspensión oscilando suavemente -->
                            <div id="m2-dirty-particles" class="pointer-events-none absolute inset-0 overflow-hidden animate-dirty-drift">
                                <span class="absolute left-6 top-8 w-2 h-1.5 rounded-full bg-amber-950/40"></span>
                                <span class="absolute left-1/2 top-14 w-2.5 h-1.5 rounded-sm bg-slate-800/40 rotate-12"></span>
                                <span class="absolute right-7 top-6 w-3 h-2 rounded-full bg-amber-900/35 -rotate-6"></span>
                                <span class="absolute left-10 bottom-6 w-2 h-2 rounded-sm bg-stone-900/30"></span>
                            </div>
                        </div>

                        <!-- Letras blancas con fondo destacado -->
                        <div class="flex flex-col items-center gap-1 w-full">
                            <span id="m2-dirty-title" class="font-black text-xs sm:text-sm text-white bg-slate-700 px-3.5 py-1 rounded-full shadow-md flex items-center justify-center gap-1 w-full transition-colors">
