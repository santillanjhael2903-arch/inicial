            btnDirty.addEventListener('pointerenter', () => { if (!isWon) btnDirty.style.transform = 'scale(1.06)'; });
            btnDirty.addEventListener('pointerleave', () => { if (!isWon && m7AlternateStep !== 1) btnDirty.style.transform = ''; });

            // Ni bien aparece, automáticamente se hace grande cada 3 segundos e intercala entre ambas imágenes con el puntero
