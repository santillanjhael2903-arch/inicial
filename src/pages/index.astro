                btnClean.classList.add('ring-4', 'ring-emerald-400', 'border-emerald-400', 'shadow-[0_0_25px_rgba(16,185,129,0.8)]');
                btnDirty.style.transform = 'scale(0.95)';
                btnDirty.classList.add('opacity-40');

                if (bagreImg) {
                    bagreImg.classList.add('animate-bin-jump');
                }

                if (sparkles) sparkles.classList.add('animate-sparkle-burst');

                addMissionTimeout(() => {
                    celebrateMission(MISSIONS[6].successMessage);
                }, 800);
            });

            // Incorrecto: Río Sucio
            btnDirty.addEventListener('click', () => {
                if (isWon) return;
                hasInteracted = true;
                stopHandPointer();

                btnDirty.classList.add('animate-gentle-shake', 'ring-4', 'ring-amber-400', 'border-amber-400');
                addMissionTimeout(() => {
                    btnDirty.classList.remove('animate-gentle-shake', 'ring-4', 'ring-amber-400', 'border-amber-400');
                    resetIdleTimer();
                }, 450);
            });
        }

        // ==========================================
        // MINI-JUEGO 8: Cada cosa en su lugar
        // ==========================================
        function renderMission8(stage: HTMLElement) {
            clearAllMissionTimers();

            stage.innerHTML = `
                <div id="m8-container" class="w-full h-full flex flex-col items-center justify-between p-2 select-none relative overflow-hidden">
                    
                    <!-- Puntero animado que recorre los cuatro tachos -->
                    <div id="m8-pointer" class="pointer-events-none absolute z-50 opacity-0 transition-opacity duration-300">
                        <img src="/images/juego 1.png" alt="Puntero de ayuda" class="w-12 sm:w-14 h-auto object-contain drop-shadow-2xl rotate-[-10deg]">
                    </div>

                    <!-- Botella animada con balanceo suave y brillo -->
                    <div id="m8-bottle" class="flex flex-col items-center cursor-pointer my-1 transition-transform duration-700">
                        <div class="relative flex items-center justify-center">
                            <img src="/images/juego 8 botella.png" alt="Botella de plástico" class="w-20 sm:w-28 h-auto object-contain drop-shadow-2xl animate-bottle-sway">
                            <div class="pointer-events-none absolute inset-0 bg-white/20 rounded-full blur-md animate-pulse"></div>
                        </div>
                        <span class="text-[11px] font-black text-white bg-slate-800/90 px-3 py-0.5 rounded-full shadow-xs mt-1">Botella de plástico</span>
                    </div>

                    <!-- 4 Tarjetas de tachos organizadas en cuadrícula -->
                    <div class="w-full grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 my-auto">
                        <!-- Marrón: Orgánico -->
                        <button id="m8-bin-brown" class="group flex flex-col items-center bg-white/95 rounded-2xl p-2 border-3 border-slate-300 shadow-md active:scale-95 hover:scale-105 transition-all cursor-pointer card-tactil-kids">
                            <div class="w-14 sm:w-18 h-16 sm:h-20 flex items-center justify-center">
                                <img src="/images/juego 8.png" alt="Tacho Marrón" class="w-full h-full object-contain drop-shadow-sm">
                            </div>
                            <span class="text-xs font-black text-white bg-amber-800 px-3 py-0.5 rounded-full mt-1">Orgánico</span>
                        </button>

                        <!-- Blanco: Plástico (Correcto) -->
                        <button id="m8-bin-white" class="group flex flex-col items-center bg-white/95 rounded-2xl p-2 border-3 border-slate-300 shadow-md active:scale-95 hover:scale-105 transition-all cursor-pointer card-tactil-kids">
                            <div class="w-14 sm:w-18 h-16 sm:h-20 flex items-center justify-center">
                                <img id="m8-white-img" src="/images/juego 8 tacho.png" alt="Tacho Blanco" class="w-full h-full object-contain drop-shadow-sm">
                            </div>
                            <span class="text-xs font-black text-white bg-emerald-600 px-3 py-0.5 rounded-full mt-1">Plástico ♻️</span>
                        </button>

                        <!-- Azul: Papel -->
                        <button id="m8-bin-blue" class="group flex flex-col items-center bg-white/95 rounded-2xl p-2 border-3 border-slate-300 shadow-md active:scale-95 hover:scale-105 transition-all cursor-pointer card-tactil-kids">
                            <div class="w-14 sm:w-18 h-16 sm:h-20 flex items-center justify-center">
                                <img src="/images/juego 8 tacho azul.png" alt="Tacho Azul" class="w-full h-full object-contain drop-shadow-sm">
                            </div>
                            <span class="text-xs font-black text-white bg-blue-600 px-3 py-0.5 rounded-full mt-1">Papel</span>
                        </button>

                        <!-- Negro: General -->
                        <button id="m8-bin-black" class="group flex flex-col items-center bg-white/95 rounded-2xl p-2 border-3 border-slate-300 shadow-md active:scale-95 hover:scale-105 transition-all cursor-pointer card-tactil-kids">
                            <div class="w-14 sm:w-18 h-16 sm:h-20 flex items-center justify-center">
                                <img src="/images/${encodeURIComponent('juego  8 tacho negro.png')}" alt="Tacho Negro" class="w-full h-full object-contain drop-shadow-sm">
                            </div>
                            <span class="text-xs font-black text-white bg-slate-800 px-3 py-0.5 rounded-full mt-1">General</span>
                        </button>
                    </div>

                    <!-- Destellos de celebración -->
                    <img id="m8-sparkles" src="/images/juego 1 destellos.png" alt="Destellos" class="pointer-events-none absolute inset-0 m-auto w-48 sm:w-64 h-auto object-contain opacity-0 z-30">
                </div>
            `;

            const container = document.getElementById('m8-container')!;
            const bottleEl = document.getElementById('m8-bottle')!;
            const btnWhite = document.getElementById('m8-bin-white')!;
            const btnBrown = document.getElementById('m8-bin-brown')!;
            const btnBlue = document.getElementById('m8-bin-blue')!;
            const btnBlack = document.getElementById('m8-bin-black')!;
            const pointer = document.getElementById('m8-pointer')!;
            const sparkles = document.getElementById('m8-sparkles')!;

            let isWon = false;
            let hasInteracted = false;
            let m8IdleTimer: any = null;
            let m8HandTimeout: any = null;

            const stopHandPointer = () => {
                if (m8HandTimeout) { clearTimeout(m8HandTimeout); m8HandTimeout = null; }
                if (pointer) pointer.style.opacity = '0';
            };

            const resetIdleTimer = () => {
                if (m8IdleTimer) clearTimeout(m8IdleTimer);
                if (!isWon) {
                    m8IdleTimer = setTimeout(() => { runPointerDemo(); }, 7000);
                }
            };

            const runPointerDemo = () => {
                if (isWon || !pointer || !container) return;
                stopHandPointer();

                const cRect = container.getBoundingClientRect();
                const buttons = [btnBrown, btnWhite, btnBlue, btnBlack];
                let idx = 0;

                const moveToNext = () => {
                    if (isWon || idx >= buttons.length) {
                        pointer.style.opacity = '0';
                        resetIdleTimer();
                        return;
                    }

                    const r = buttons[idx].getBoundingClientRect();
                    const x = (r.left + r.width * 0.5) - cRect.left;
                    const y = (r.top + r.height * 0.5) - cRect.top;

                    pointer.style.transition = 'left 0.8s ease, top 0.8s ease, opacity 0.3s ease';
                    pointer.style.left = `${x}px`;
                    pointer.style.top = `${y}px`;
                    pointer.style.opacity = '1';

                    idx++;
                    m8HandTimeout = setTimeout(moveToNext, 1000);
                };

                pointer.style.transition = 'none';
                pointer.style.opacity = '0';
                m8HandTimeout = setTimeout(moveToNext, 300);
            };

            addMissionTimeout(() => {
                if (!hasInteracted && !isWon) runPointerDemo();
            }, 800);

            // Respuesta correcta: Tacho Blanco (Plástico)
            btnWhite.addEventListener('click', () => {
                if (isWon) return;
                isWon = true;
                hasInteracted = true;
                stopHandPointer();

                btnWhite.classList.add('scale-105', 'ring-4', 'ring-emerald-400', 'border-emerald-400', 'shadow-[0_0_25px_rgba(16,185,129,0.8)]');

                // La botella se desplaza suavemente hacia el tacho blanco
                const botRect = bottleEl.getBoundingClientRect();
                const binRect = btnWhite.getBoundingClientRect();
                const deltaX = (binRect.left + binRect.width * 0.5) - (botRect.left + botRect.width * 0.5);
                const deltaY = (binRect.top + binRect.height * 0.3) - (botRect.top + botRect.height * 0.5);

                bottleEl.style.transition = 'transform 0.7s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease';
                bottleEl.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(0.25) rotate(30deg)`;
                bottleEl.style.opacity = '0';

                addMissionTimeout(() => {
                    btnWhite.classList.add('animate-bin-jump');
                    if (sparkles) sparkles.classList.add('animate-sparkle-burst');

                    addMissionTimeout(() => {
                        celebrateMission(MISSIONS[7].successMessage);
                    }, 800);
                }, 700);
            });

            // Respuesta incorrecta suave
            const handleWrongBin = (btn: HTMLElement) => {
                if (isWon) return;
                hasInteracted = true;
                stopHandPointer();

                btn.classList.add('animate-gentle-shake', 'ring-4', 'ring-amber-400', 'border-amber-400');
                addMissionTimeout(() => {
                    btn.classList.remove('animate-gentle-shake', 'ring-4', 'ring-amber-400', 'border-amber-400');
                    resetIdleTimer();
                }, 450);
            };

            btnBrown.addEventListener('click', () => handleWrongBin(btnBrown));
            btnBlue.addEventListener('click', () => handleWrongBin(btnBlue));
            btnBlack.addEventListener('click', () => handleWrongBin(btnBlack));
        }

        // --- RESULTS LOGIC ---
        function showResults() {
            goToScreen('game', 'results');
            document.getElementById('app-bg')!.style.backgroundImage = "url('/images/fondo.png')";
            
            document.getElementById('result-score')!.innerText = `${state.score}/${MISSIONS.length}`;

            const playerBadge = document.getElementById('result-player-name');
            if (playerBadge) playerBadge.innerText = state.playerName;

            const mascotEl = document.getElementById('result-mascot') as HTMLImageElement;
            const titleEl = document.getElementById('result-title')!;
            const msgEl = document.getElementById('result-msg')!;
            const resultBox = document.getElementById('result-score')!;

            if (state.score === MISSIONS.length) {
                mascotEl.src = "/images/celebra.png";
                titleEl.innerText = "¡ECO HÉROE! 🏆";
                titleEl.className = "text-base sm:text-lg font-black mb-1.5 text-emerald-600";
                resultBox.className = "text-2xl sm:text-3xl font-black text-emerald-600";
                msgEl.innerText = `¡Felicidades, ${state.playerName}! Puntuación perfecta. ¡Lo hiciste genial!`;
                fireConfetti();
            } else if (state.score >= MISSIONS.length - 1) {
                mascotEl.src = "/images/celebra.png";
                titleEl.innerText = "¡MUY BIEN, ECO-EXPLORADOR! 🏅";
                titleEl.className = "text-base sm:text-lg font-black mb-1.5 text-blue-600";
                resultBox.className = "text-2xl sm:text-3xl font-black text-blue-600";
                msgEl.innerText = `¡Casi perfecto, ${state.playerName}! Demostraste sólidos conocimientos sobre el río Huallaga.`;
                fireConfetti(); 
            } else {
                mascotEl.src = "/images/saluda.png";
                titleEl.innerText = "SIGUE APRENDIENDO 🌱";
                titleEl.className = "text-base sm:text-lg font-black mb-1.5 text-slate-700";
                resultBox.className = "text-2xl sm:text-3xl font-black text-slate-600";
                msgEl.innerText = `¡Buen intento, ${state.playerName}! Cada intento ayuda a conocer más sobre el río Huallaga. ¡Inténtalo otra vez!`;
            }

            // Enlace directo de WhatsApp con nombre y puntaje
            const waMsg = encodeURIComponent(`¡Hola! Soy ${state.playerName}, completé el desafío Misión Eco-Exploradores con un puntaje de ${state.score}/${MISSIONS.length} y reclamo mi insignia de Eco-Explorador 🏅🌿`);
            const waBtn = document.getElementById('btn-whatsapp') as HTMLAnchorElement;
            if (waBtn) waBtn.href = `https://wa.me/51913346476?text=${waMsg}`;
        }

        function fireConfetti() {
            const duration = 3000;
            const end = Date.now() + duration;

            (function frame() {
                (window as any).confetti({ particleCount: 5, angle: 60, spread: 55, origin: { x: 0 }, colors: ['#10b981', '#3b82f6', '#f59e0b'] });
                (window as any).confetti({ particleCount: 5, angle: 120, spread: 55, origin: { x: 1 }, colors: ['#10b981', '#3b82f6', '#f59e0b'] });
                if (Date.now() < end) requestAnimationFrame(frame);
            }());
        }

        // --- EVENT LISTENERS ---
        document.getElementById('btn-start')?.addEventListener('click', async () => {
            const input = document.getElementById('player-name') as HTMLInputElement;
            const name = input?.value.trim();
            const errorEl = document.getElementById('name-error');

            if (!name) {
                if (errorEl) errorEl.classList.remove('hidden');
                input?.focus();
                input?.classList.add('border-rose-400', 'bg-rose-50/40');
                return;
            }

            if (errorEl) errorEl.classList.add('hidden');
            state.playerName = name;
            if (startIntroAudio && !presentationFinished) {
                try {
                    if (startIntroAudio.paused) await startIntroAudio.play();
                    await new Promise<void>((resolve) => {
                        if (presentationFinished) return resolve();
                        startIntroAudio.addEventListener('ended', () => resolve(), { once: true });
                    });
                } catch {
                    // Si el navegador no permite reproducir el audio, deja continuar el flujo.
                }
            }
            startIntroAudio?.pause();
            if (uploadGuideAudio) {
                uploadGuideAudio.currentTime = 0;
                uploadGuideAudio.play().catch(() => {});
            }
            goToScreen('start', 'upload');
        });

        document.getElementById('player-name')?.addEventListener('input', () => {
            const errorEl = document.getElementById('name-error');
            const input = document.getElementById('player-name') as HTMLInputElement;
            if (errorEl) errorEl.classList.add('hidden');
            input?.classList.remove('border-rose-400', 'bg-rose-50/40');
        });

        document.getElementById('player-name')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                document.getElementById('btn-start')?.click();
            }
        });

        document.getElementById('upload-dropzone')?.addEventListener('click', () => {
            const input = document.getElementById('file-input') as HTMLInputElement;
            input.value = '';
            input.click();
        });

        // Configuración de Gemini API Key en UI
        const btnGemini = document.getElementById('btn-config-gemini');
        const statusText = document.getElementById('gemini-status-text');

        function updateGeminiStatus() {
            const key = (import.meta.env.PUBLIC_GEMINI_API_KEY || localStorage.getItem('gemini_api_key') || (window as any).GEMINI_API_KEY);
            if (key && statusText) {
                statusText.innerText = 'Gemini Activa ✅';
                btnGemini?.classList.remove('bg-emerald-100', 'text-emerald-800');
                btnGemini?.classList.add('bg-emerald-600', 'text-white');
            }
        }
        updateGeminiStatus();

        btnGemini?.addEventListener('click', () => {
            const current = localStorage.getItem('gemini_api_key') || '';
            const inputKey = prompt(
                "Ingresa tu clave de API de Gemini (de Google AI Studio: aistudio.google.com) para análisis en tiempo real con Gemini 1.5 Flash Vision.\n(Deja en blanco para usar la IA de visión por computadora local en el navegador):",
                current
            );
            if (inputKey !== null) {
                if (inputKey.trim()) {
                    localStorage.setItem('gemini_api_key', inputKey.trim());
                    alert("¡Clave de Gemini guardada con éxito! Las fotos se enviarán a Gemini 1.5 Flash para su análisis ecológico.");
                } else {
                    localStorage.removeItem('gemini_api_key');
                    alert("Se usará la IA de visión computacional local en tu navegador.");
                }
                updateGeminiStatus();
            }
        });

        // Drag & Drop support
        const dropzone = document.getElementById('upload-dropzone');
        if (dropzone) {
            dropzone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropzone.classList.add('border-emerald-500', 'bg-emerald-50/50');
            });
            dropzone.addEventListener('dragleave', () => {
                dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/50');
            });
            dropzone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/50');
                const file = (e as DragEvent).dataTransfer?.files[0];
                if (file) {
                    const input = document.getElementById('file-input') as HTMLInputElement;
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    input.files = dt.files;
                    input.dispatchEvent(new Event('change'));
                }
            });
        }

        document.getElementById('file-input')?.addEventListener('change', (e) => {
            processUpload(e);
        });

        document.getElementById('btn-retry-upload')?.addEventListener('click', () => {
            resetUpload();
        });

        document.getElementById('btn-start-game')?.addEventListener('click', () => {
            uploadGuideAudio?.pause();
            if (uploadGuideAudio) uploadGuideAudio.currentTime = 0;
            startGame();
        });

        document.getElementById('btn-change-image')?.addEventListener('click', () => {
            document.getElementById('upload-success')!.classList.add('hidden');
            document.getElementById('upload-success')!.classList.remove('flex');
            document.getElementById('upload-initial-box')?.classList.remove('hidden');
            (document.getElementById('file-input') as HTMLInputElement).value = '';
            if (currentObjectUrl) {
                URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = null;
            }
        });

        document.getElementById('btn-close-game')?.addEventListener('click', () => {
            location.reload();
        });

        document.getElementById('btn-restart')?.addEventListener('click', () => {
            location.reload();
        });
    </script>
</Layout>
