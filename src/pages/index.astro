                        pointer.style.top = `${cardY}px`;
                        pointer.style.opacity = '1';
                    }

                    m7AlternateStep = 0;
                }
            };

            const dirtyBtnActive = () => btnDirty && !isWon;

            // Iniciar ciclo automático cada 3 segundos
            const m7Interval = setInterval(runAlternatingZoom, 3000);
            activeMissionTimeouts.push(m7Interval);

