                        <!-- Ventana de imagen con zoom suave, reflejos y burbujas ascendentes -->
                        <div class="w-full h-28 sm:h-36 rounded-2xl overflow-hidden mb-2.5 bg-emerald-100 border-2 border-emerald-300 relative shadow-inner">
