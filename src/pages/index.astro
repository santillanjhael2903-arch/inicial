                            <!-- Reflejos luminosos sutiles de agua y rayos de sol -->
                            <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-cyan-400/10 via-white/20 to-emerald-200/25 animate-water-shimmer"></div>

                            <!-- Burbujas semitransparentes ascendiendo lentamente -->
                            <div class="pointer-events-none absolute inset-0 overflow-hidden">
