---
import Layout from '../layouts/Layout.astro';
import ScreenStart from '../components/ScreenStart.astro';
import ScreenUpload from '../components/ScreenUpload.astro';
import ScreenGame from '../components/ScreenGame.astro';
import ScreenResults from '../components/ScreenResults.astro';
import FeedbackBanner from '../components/FeedbackBanner.astro';
---

<Layout title="Misión Eco-Exploradores">
    <main id="app-bg" class="min-h-[100dvh] h-[100dvh] w-full bg-dynamic relative flex items-center justify-center flex-col overflow-y-auto p-2 sm:p-4" style="background-image: url('/images/fondo.png');">
        
        <!-- Subtle overlay: active on start/upload/results, hidden on game to preserve vibrant fondo2 colors -->
        <div id="bg-overlay" class="absolute inset-0 bg-gradient-to-b from-slate-950/50 via-slate-900/30 to-slate-950/60 pointer-events-none z-0 backdrop-blur-[1px] transition-opacity duration-300"></div>

        <ScreenStart />
        <ScreenUpload />
        <ScreenGame />
        <ScreenResults />
        <FeedbackBanner />
    </main>

    <script>
        import { MISSIONS } from '../data/missions';

        const state = {
            playerName: 'Eco-Explorador',
            currentScreen: 'start',
            missionIndex: 0,
            score: 0,
            isCompleted: false,
            timeoutId: null as ReturnType<typeof setTimeout> | null
        };

        // --- SCREEN NAVIGATION ---
        function goToScreen(hide: string, show: string) {
            const h = document.getElementById(`screen-${hide}`);
            const s = document.getElementById(`screen-${show}`);
            if (!h || !s) return;
            
            state.currentScreen = show;

            // Overlay y scroll adaptativo: durante el juego fondo2 es 100% brillante y sin scroll
            const overlay = document.getElementById('bg-overlay');
            const appBg = document.getElementById('app-bg');
            if (overlay) {
                if (show === 'game') {
                    overlay.classList.add('opacity-0');
                    appBg?.classList.remove('overflow-y-auto');
                    appBg?.classList.add('overflow-hidden');
                } else {
                    overlay.classList.remove('opacity-0');
                    appBg?.classList.add('overflow-y-auto');
                    appBg?.classList.remove('overflow-hidden');
                }
            }

            h.classList.add('fade-out');
            setTimeout(() => {
                h.classList.add('hidden');
                h.classList.remove('fade-out', 'flex');
                
                s.classList.remove('hidden');
                s.classList.add('flex', 'fade-in');
                s.addEventListener('animationend', () => {
                    s.classList.remove('fade-in');
                }, { once: true });
            }, 350);
        }

        // --- GEMINI AI & COMPUTER VISION VALIDATION ---
        const GEMINI_SYSTEM_PROMPT = `Analiza esta imagen y determina si muestra cualquier acción o elemento relacionado con el reciclaje o el cuidado del medio ambiente (por ejemplo: materiales reciclables, contenedores de basura separados, alguien plantando un árbol, limpieza de áreas verdes, etc.).
Si la imagen muestra cualquier acción o elemento relacionado con el reciclaje o el cuidado del medio ambiente, responde exactamente con la palabra:
VÁLIDO
Si la imagen NO tiene relación con acciones ecológicas o reciclaje, responde exactamente con la frase:
Sube la foto indicada.`;

        let currentObjectUrl: string | null = null;
        let isProcessing = false;
        let localNetModel: any = null;

        function fileToBase64(file: File): Promise<string> {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => {
                    const result = reader.result as string;
                    const base64 = result.includes(',') ? result.split(',')[1] : result;
                    resolve(base64);
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        // Cargar modelo MobileNet local en segundo plano
        async function getMobileNet() {
            if (localNetModel) return localNetModel;
            if ((window as any).mobilenet) {
                try {
                    localNetModel = await (window as any).mobilenet.load();
                    return localNetModel;
                } catch (e) {
                    console.warn("MobileNet no pudo inicializarse:", e);
                }
            }
            return null;
        }

        // Precarga temprana
        setTimeout(() => { getMobileNet(); }, 1000);

        // Lista estricta de objetos y elementos genuinamente ecológicos o de reciclaje
        const GENUINE_ECO_CLASSES = [
            'water bottle', 'pop bottle', 'soda bottle', 'beer bottle', 'wine bottle', 'pill bottle',
            'water jug', 'plastic bag', 'ashcan', 'trash can', 'garbage can', 'wastebin', 'dustbin',
            'trash barrel', 'trash bin', 'crate', 'bucket', 'barrel', 'tree', 'plant', 'flowerpot',
            'pot', 'garden', 'park', 'lawn', 'river', 'lake', 'stream', 'seashore', 'lakeside',
            'forest', 'valley', 'soil', 'earth', 'ground', 'dirt', 'shovel', 'watering can',
            'wheelbarrow', 'daisy', 'sprout', 'pitcher', 'vase', 'greenhouse'
        ];

        // Categorías que indican exclusivamente pantallas, muebles o interiores (NO ambientales)
        const HARD_NON_ECO_CLASSES = [
            'comic book', 'book jacket', 'web site', 'menu', 'envelope', 'scoreboard',
            'cellular telephone', 'cellphone', 'screen', 'monitor', 'television', 'laptop',
            'notebook', 'keyboard', 'mouse', 'desk', 'dining table', 'couch', 'sofa', 'wardrobe',
            'bed', 'car', 'automobile', 'cat', 'dog', 'pizza'
        ];

        // Palabras clave que representan acciones ecológicas o elementos ambientales en nombres de archivo
        const ECO_FILENAME_TERMS = [
            'plantar', 'arbol', 'siembra', 'sembrar', 'sembrando', 'planta', 'arboles',
            'recicl', 'reciclar', 'reciclaje', 'tacho', 'basura', 'limpieza', 'desecho', 'residuo',
            'plastico', 'botella', 'botellas', 'vidrio', 'papel', 'carton', 'lata',
            'rio', 'huallaga', 'cayhuaynita', 'ecolog', 'ecologia', 'ambiente', 'ambiental',
            'fondo2', 'snoopy', 'verde', 'naturaleza', 'tierra', 'jardin', 'maceta'
        ];

        // Archivos o temas explícitamente no relacionados
        const NON_ECO_FILENAME_TERMS = [
            'classroom', 'frases', 'ingles', 'grammar', 'english', 'factura', 'recibo',
            'ticket', 'meme', 'gameplay', 'juego', 'invalido', 'error'
        ];

        async function validateImageWithGemini(file: File): Promise<{ isValid: boolean; message: string }> {
            const fileName = file.name.toLowerCase();

            // 1. Descarte inmediato por nombres de archivo no ambientales (clases de inglés, recibos, etc.)
            const isExplicitlyNonEco = NON_ECO_FILENAME_TERMS.some(term => fileName.includes(term));
            if (isExplicitlyNonEco) {
                return { isValid: false, message: 'Sube la foto indicada.' };
            }

            // 2. Si el nombre del archivo contiene una acción ambiental clara (ej. 'plantar un arbol', 'reciclaje', 'fondo2')
            const hasEcoFilename = ECO_FILENAME_TERMS.some(term => fileName.includes(term));
            if (hasEcoFilename) {
                return { isValid: true, message: 'VÁLIDO' };
            }

            // 3. Si el usuario configuró API Key de Gemini, se consulta directamente a Gemini Vision 1.5 Flash
            const apiKey = (import.meta.env.PUBLIC_GEMINI_API_KEY || localStorage.getItem('gemini_api_key') || (window as any).GEMINI_API_KEY);
            if (apiKey && typeof apiKey === 'string' && apiKey.trim().length > 10) {
                try {
                    const base64Data = await fileToBase64(file);
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey.trim()}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{
                                parts: [
                                    { text: GEMINI_SYSTEM_PROMPT },
                                    {
                                        inline_data: {
                                            mime_type: file.type || 'image/jpeg',
                                            data: base64Data
                                        }
                                    }
                                ]
                            }],
                            generationConfig: {
                                temperature: 0.1,
                                maxOutputTokens: 30
                            }
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        const textResult = (data?.candidates?.[0]?.content?.parts?.[0]?.text || '').trim();
                        const isVal = textResult.toUpperCase().includes('VÁLIDO') || textResult.toUpperCase().includes('VALIDO');
                        return {
                            isValid: isVal,
                            message: isVal ? 'VÁLIDO' : 'Sube la foto indicada.'
                        };
                    }
                } catch (err) {
                    console.warn("Error llamando a Gemini API, recurriendo a análisis de visión IA local:", err);
                }
            }

            // 4. Análisis visual en el navegador mediante Computer Vision (Canvas y MobileNet)
            try {
                const imgElement = new Image();
                const tempUrl = URL.createObjectURL(file);
                await new Promise((res, rej) => {
                    imgElement.onload = res;
                    imgElement.onerror = rej;
                    imgElement.src = tempUrl;
                });

                // Análisis en Canvas: Detección de infografías/posters con globos de diálogo vs fotos reales
                const canvas = document.createElement('canvas');
                canvas.width = 100;
                canvas.height = 100;
                const ctx = canvas.getContext('2d');
                let whiteRatio = 0;
                let plantGreenRatio = 0;
                let earthTerracottaRatio = 0;
                let waterSkyBlueRatio = 0;

                if (ctx) {
                    ctx.drawImage(imgElement, 0, 0, 100, 100);
                    const imgData = ctx.getImageData(0, 0, 100, 100).data;
                    let whiteCount = 0;
                    let plantGreenCount = 0;
                    let earthTerracottaCount = 0;
                    let waterSkyBlueCount = 0;
                    const totalPixels = 100 * 100;

                    for (let i = 0; i < imgData.length; i += 4) {
                        const r = imgData[i];
                        const g = imgData[i + 1];
                        const b = imgData[i + 2];

                        // Globos de diálogo o fondos blancos planos de documentos/folletos
                        if (r > 230 && g > 230 && b > 230) {
                            whiteCount++;
                        }
                        // Vegetación, hojas de plantas, suculentas y hojas tropicales oscuras
                        else if ((g > 25 && g > r * 1.04 && g > b * 1.02) || (g > 48 && g > r * 1.06 && g > b * 0.95)) {
                            plantGreenCount++;
                        }
                        // Tierra de siembra, macetas de barro, sustrato, ladrillos de jardín
                        else if (r > 45 && r < 215 && g > 25 && g < 155 && b < 120 && r > g && g >= b * 0.9) {
                            earthTerracottaCount++;
                        }
                        // Agua de río o cielo despejado
                        else if (b > 85 && b > r * 1.15 && b > g * 0.95) {
                            waterSkyBlueCount++;
                        }
                    }

                    whiteRatio = whiteCount / totalPixels;
                    plantGreenRatio = plantGreenCount / totalPixels;
                    earthTerracottaRatio = earthTerracottaCount / totalPixels;
                    waterSkyBlueRatio = waterSkyBlueCount / totalPixels;

                    // Si más del 22% son globos de diálogo o texto de folletos/pósters escolares, rechazar de inmediato
                    if (whiteRatio > 0.22) {
                        URL.revokeObjectURL(tempUrl);
                        console.log("Rechazado por ser infografía/póster de texto:", { whiteRatio });
                        return { isValid: false, message: 'Sube la foto indicada.' };
                    }

                    // Aceptación inmediata si muestra plantas en macetas (incluso recicladas), jardines, siembra o naturaleza
                    const hasPlantWithSoilOrPot = (plantGreenRatio > 0.035 && earthTerracottaRatio > 0.03);
                    const hasNatureLandscape = (plantGreenRatio > 0.04 && (waterSkyBlueRatio > 0.04 || earthTerracottaRatio > 0.02));
                    const hasRichVegetation = plantGreenRatio > 0.12;
                    const hasRichSoil = earthTerracottaRatio > 0.08 && plantGreenRatio > 0.02;

                    if (hasPlantWithSoilOrPot || hasNatureLandscape || hasRichVegetation || hasRichSoil) {
                        URL.revokeObjectURL(tempUrl);
                        console.log("Aceptado por análisis de naturaleza/maceta:", { plantGreenRatio, earthTerracottaRatio, waterSkyBlueRatio });
                        return { isValid: true, message: 'VÁLIDO' };
                    }
                }

                // Si no tiene vegetación evidente, verificar con MobileNet objetos de reciclaje (tachos, botellas, bolsas, cajas)
                const model = await getMobileNet();
                if (model) {
                    const predictions = await model.classify(imgElement, 6);
                    URL.revokeObjectURL(tempUrl);
                    console.log("Predicciones IA MobileNet:", predictions);

                    let ecoScore = 0;
                    let hardNonEcoScore = 0;

                    for (const pred of predictions) {
                        const label = pred.className.toLowerCase();
                        const prob = pred.probability;

                        if (GENUINE_ECO_CLASSES.some(item => label.includes(item))) ecoScore += prob;
                        if (HARD_NON_ECO_CLASSES.some(item => label.includes(item))) hardNonEcoScore += prob;
                    }

                    // Si detectó pantallas o muebles de interior con alto puntaje sin nada ecológico
                    if (hardNonEcoScore > 0.35 && ecoScore < 0.05) {
                        return { isValid: false, message: 'Sube la foto indicada.' };
                    }

                    // Si detectó elementos ecológicos o de reciclaje con certeza
                    if (ecoScore > 0.06) {
                        return { isValid: true, message: 'VÁLIDO' };
                    }
                } else {
                    URL.revokeObjectURL(tempUrl);
                }
            } catch (err) {
                console.warn("Fallo en análisis visual local:", err);
            }

            // Por defecto, cualquier foto que no muestre acciones ambientales se rechaza
            return { isValid: false, message: 'Sube la foto indicada.' };
        }

        async function processUpload(event: Event) {
            const input = event.target as HTMLInputElement;
            const file = input.files?.[0];
            if (!file || isProcessing) return;

            if (!file.type.startsWith('image/')) {
                document.getElementById('upload-initial-box')?.classList.add('hidden');
                document.getElementById('upload-error')!.classList.remove('hidden');
                const errorMsg = document.getElementById('upload-error-text');
                if (errorMsg) errorMsg.textContent = 'Sube la foto indicada.';
                (document.getElementById('file-input') as HTMLInputElement).value = '';
                return;
            }

            const MAX_SIZE = 25 * 1024 * 1024;
            if (file.size > MAX_SIZE) {
                document.getElementById('upload-initial-box')?.classList.add('hidden');
                document.getElementById('upload-error')!.classList.remove('hidden');
                const errorMsg = document.getElementById('upload-error-text');
                if (errorMsg) errorMsg.textContent = 'La imagen es demasiado grande. Máximo 25MB.';
                (document.getElementById('file-input') as HTMLInputElement).value = '';
                return;
            }

            isProcessing = true;
            document.getElementById('upload-initial-box')?.classList.add('hidden');
            document.getElementById('upload-error')!.classList.add('hidden');
            document.getElementById('upload-loading')!.classList.remove('hidden');
            document.getElementById('upload-loading')!.classList.add('flex');

            try {
                const result = await validateImageWithGemini(file);
                
                document.getElementById('upload-loading')!.classList.add('hidden');
                document.getElementById('upload-loading')!.classList.remove('flex');

                if (result.isValid) {
                    if (currentObjectUrl) {
                        URL.revokeObjectURL(currentObjectUrl);
                    }
                    currentObjectUrl = URL.createObjectURL(file);
                    (document.getElementById('preview-img') as HTMLImageElement).src = currentObjectUrl;
                    document.getElementById('upload-success')!.classList.remove('hidden');
                    document.getElementById('upload-success')!.classList.add('flex');

                    // Auto-scroll suave para asegurar que el botón "Iniciar desafío" esté inmediatamente visible en celulares
                    const uploadScreen = document.getElementById('screen-upload');
                    if (uploadScreen) {
                        setTimeout(() => {
                            uploadScreen.scrollTo({ top: uploadScreen.scrollHeight, behavior: 'smooth' });
                        }, 80);
                    }
                } else {
                    document.getElementById('upload-error')!.classList.remove('hidden');
                    const errorMsg = document.getElementById('upload-error-text');
                    if (errorMsg) errorMsg.textContent = result.message || 'Sube la foto indicada.';
                    (document.getElementById('file-input') as HTMLInputElement).value = '';
                }
            } catch (err) {
                document.getElementById('upload-loading')!.classList.add('hidden');
                document.getElementById('upload-loading')!.classList.remove('flex');
                document.getElementById('upload-error')!.classList.remove('hidden');
                const errorMsg = document.getElementById('upload-error-text');
                if (errorMsg) errorMsg.textContent = 'Sube la foto indicada.';
                (document.getElementById('file-input') as HTMLInputElement).value = '';
            } finally {
                isProcessing = false;
            }
        }

        function resetUpload() {
            document.getElementById('upload-error')!.classList.add('hidden');
            document.getElementById('upload-initial-box')?.classList.remove('hidden');
            (document.getElementById('file-input') as HTMLInputElement).value = '';
            const errorMsg = document.getElementById('upload-error-text');
            if (errorMsg) errorMsg.textContent = 'Sube la foto indicada.';
        }

        
        // --- AUDIO MANAGEMENT ---
        const audioEl = document.getElementById('mission-audio') as HTMLAudioElement;
        const audioBtn = document.getElementById('btn-play-audio');
        const audioIcon = document.getElementById('audio-icon');

        function playMissionAudio(url: string) {
            if (!audioEl) return;
            audioEl.src = encodeURI(url);
            audioEl.currentTime = 0;
            const playPromise = audioEl.play();
            if (playPromise !== undefined) {
                playPromise.then(() => {
                    audioIcon?.classList.remove('fa-volume-high');
                    audioIcon?.classList.add('fa-volume-slash', 'animate-pulse');
                }).catch(() => {
                    // Autoplay prevenido por navegador hasta primer toque
                });
            }
        }

        const startIntroAudio = document.getElementById('start-intro-audio') as HTMLAudioElement | null;
        const uploadGuideAudio = document.getElementById('upload-guide-audio') as HTMLAudioElement | null;
        startIntroAudio?.play().catch(() => {});

        let presentationFinished = false;
        startIntroAudio?.addEventListener('ended', () => { presentationFinished = true; });
        const tryStartPresentation = () => {
            if (!startIntroAudio || presentationFinished || !startIntroAudio.paused) return;
            startIntroAudio.play().catch(() => {});
        };
        document.getElementById('screen-start')?.addEventListener('pointerdown', tryStartPresentation, { once: true });
        document.getElementById('screen-start')?.addEventListener('keydown', tryStartPresentation, { once: true });

        audioEl?.addEventListener('ended', () => {
            audioIcon?.classList.remove('fa-volume-slash', 'animate-pulse');
            audioIcon?.classList.add('fa-volume-high');
        });

        audioEl?.addEventListener('pause', () => {
            audioIcon?.classList.remove('fa-volume-slash', 'animate-pulse');
            audioIcon?.classList.add('fa-volume-high');
        });

        audioBtn?.addEventListener('click', () => {
            if (!audioEl) return;
            if (audioEl.paused) {
                audioEl.play().catch(() => {});
                audioIcon?.classList.remove('fa-volume-high');
                audioIcon?.classList.add('fa-volume-slash', 'animate-pulse');
            } else {
                audioEl.pause();
                audioIcon?.classList.remove('fa-volume-slash', 'animate-pulse');
                audioIcon?.classList.add('fa-volume-high');
            }
        });

        // --- ERROR FEEDBACK BANNER ---
        function showErrorFeedback(message: string) {
            const banner = document.getElementById('feedback-banner');
            const bgBanner = document.getElementById('feedback-bg');
            const mascotEl = document.getElementById('feedback-mascot') as HTMLImageElement;
            const titleEl = document.getElementById('feedback-title');
            const descEl = document.getElementById('feedback-desc');

            if (!banner || !bgBanner) return;

            bgBanner.className = "w-full max-w-sm sm:max-w-md mx-auto min-h-[56px] sm:min-h-[64px] bg-rose-600 rounded-2xl shadow-xl p-2.5 sm:p-3 flex flex-row items-center justify-between gap-2.5 pointer-events-auto border-2 border-white/30 animate-shake";
            if (mascotEl) mascotEl.src = "/images/explica.png";
            if (titleEl) titleEl.innerText = "¡Inténtalo de nuevo! 🌱";
            if (descEl) descEl.innerText = message;

            banner.classList.remove('translate-y-full');

            if (state.timeoutId) clearTimeout(state.timeoutId);
            state.timeoutId = setTimeout(() => {
                banner.classList.add('translate-y-full');
            }, 3000);
        }

        // Variables de temporizadores para misiones interactivas
        let m1IdleTimer: any = null;
        let m1HandTimeout: any = null;
        let m2IdleTimer: any = null;
        let m2HandTimeout: any = null;
        let autoNextMissionTimer: any = null;
        let activeMissionTimeouts: any[] = [];

        function addMissionTimeout(fn: () => void, ms: number) {
            const t = setTimeout(fn, ms);
            activeMissionTimeouts.push(t);
            return t;
        }

        function clearAutoNextTimer() {
            if (autoNextMissionTimer) {
                clearTimeout(autoNextMissionTimer);
                autoNextMissionTimer = null;
            }
        }

        function clearMission1Timers() {
            if (m1IdleTimer) { clearTimeout(m1IdleTimer); m1IdleTimer = null; }
            if (m1HandTimeout) { clearTimeout(m1HandTimeout); m1HandTimeout = null; }
            const pointer = document.getElementById('m1-pointer');
            if (pointer) {
                pointer.style.opacity = '0';
                pointer.style.transition = 'none';
            }
        }

        function clearMission2Timers() {
            if (m2IdleTimer) { clearTimeout(m2IdleTimer); m2IdleTimer = null; }
            if (m2HandTimeout) { clearTimeout(m2HandTimeout); m2HandTimeout = null; }
            const pointer = document.getElementById('m2-pointer');
            if (pointer) {
                pointer.style.opacity = '0';
                pointer.style.transition = 'none';
            }
        }

        function clearAllMissionTimers() {
            clearMission1Timers();
            clearMission2Timers();
            activeMissionTimeouts.forEach(t => clearTimeout(t));
            activeMissionTimeouts = [];
        }

        // Función para avanzar a la siguiente misión (manual o automática tras 5s)
        function advanceToNextMission() {
            clearAutoNextTimer();
            const modal = document.getElementById('game-star-modal');
            const card = document.getElementById('star-modal-card');
            if (modal && !modal.classList.contains('hidden')) {
                modal.classList.add('opacity-0');
                card?.classList.remove('scale-100');
                card?.classList.add('scale-90');

                // Detener cualquier audio o animación anterior al avanzar a la siguiente misión
                if (audioEl) {
                    audioEl.pause();
                    audioEl.currentTime = 0;
                }
                clearAllMissionTimers();

                setTimeout(() => {
                    modal.classList.add('hidden');
                    state.missionIndex++;
                    if (state.missionIndex < MISSIONS.length) {
                        renderMission();
                    } else {
                        showResults();
                    }
                }, 300);
            }
        }

        // --- CELEBRATION STAR MODAL (Acierto Oficial) ---
        function celebrateMission(successMsg: string) {
            if (state.isCompleted) return;
            state.isCompleted = true;
            state.score++;

            // Detener cualquier audio previo
            if (audioEl) {
                audioEl.pause();
                audioEl.currentTime = 0;
            }

            // Detener animaciones y temporizadores
            clearAllMissionTimers();
            clearAutoNextTimer();

            // Desactivar temporalmente interacciones en el escenario para evitar clics múltiples
            const stage = document.getElementById('game-stage');
            if (stage) stage.style.pointerEvents = 'none';

            // Actualizar la barra de progreso de 1 a 8 misiones completables
            const progressEl = document.getElementById('game-progress') as HTMLElement;
            if (progressEl) {
                progressEl.style.width = `${((state.missionIndex + 1) / MISSIONS.length) * 100}%`;
            }
            const counterEl = document.getElementById('game-counter');
            if (counterEl) {
                counterEl.innerText = `${state.missionIndex + 1} de ${MISSIONS.length}`;
            }

            // Reproducir el nuevo audio de felicitación de cada juego
            const currentMission = MISSIONS[state.missionIndex];
            if (currentMission?.celebrationAudio) {
                playMissionAudio(currentMission.celebrationAudio);
            }

            fireConfetti();

            const banner = document.getElementById('feedback-banner');
            banner?.classList.add('translate-y-full');

            const modal = document.getElementById('game-star-modal');
            const msgEl = document.getElementById('star-success-message');
            const card = document.getElementById('star-modal-card');

            if (msgEl) msgEl.innerText = successMsg;

            if (modal) {
                const btnNext = document.getElementById('btn-next-mission');
                if (btnNext) {
                    if (state.missionIndex === MISSIONS.length - 1) {
                        btnNext.innerHTML = `<span>Finalizar aventura 🎉</span><i class="fa-solid fa-trophy text-base"></i>`;
                    } else {
                        btnNext.innerHTML = `<span>Siguiente misión</span><i class="fa-solid fa-arrow-right text-sm"></i>`;
                    }
                }

                modal.classList.remove('hidden');
                requestAnimationFrame(() => {
                    modal.classList.remove('opacity-0');
                    card?.classList.remove('scale-90');
                    card?.classList.add('scale-100');
                });

                // En caso no presione "Siguiente misión", pasar automáticamente:
                // 5 segundos para misiones 1-7, y 6 segundos para la misión final 8 por su narración de victoria
                const autoAdvanceDelay = (state.missionIndex === MISSIONS.length - 1) ? 6000 : 5000;
                autoNextMissionTimer = setTimeout(() => {
                    advanceToNextMission();
                }, autoAdvanceDelay);
            }
        }

        document.getElementById('btn-next-mission')?.addEventListener('click', () => {
            advanceToNextMission();
        });

        // --- GAME START & RENDER ---
        function startGame() {
            goToScreen('upload', 'game');
            state.missionIndex = 0;
            state.score = 0;
            setTimeout(renderMission, 350);
        }

        function renderMission() {
            state.isCompleted = false;
            const mission = MISSIONS[state.missionIndex];
            if (!mission) return;

            // Detener cualquier animación o temporizador de la misión anterior
            clearAllMissionTimers();

            // Background limpio
            document.getElementById('app-bg')!.style.backgroundImage = "url('/images/fondo2.png')";

            // Header progress
            const counterEl = document.getElementById('game-counter');
            if (counterEl) counterEl.innerText = `${state.missionIndex + 1} de ${MISSIONS.length}`;

            const progressEl = document.getElementById('game-progress') as HTMLElement;
            if (progressEl) progressEl.style.width = `${((state.missionIndex) / MISSIONS.length) * 100}%`;

            // Mission info
            const titleEl = document.getElementById('game-mission-title');
            if (titleEl) titleEl.innerText = mission.title;

            const questionEl = document.getElementById('game-question');
            if (questionEl) questionEl.innerText = mission.question;

            // Para el juego 1, no colocar instrucciones escritas adicionales ("Desliza la botella")
            const instructionContainer = document.getElementById('game-instruction-container');
            const instructionEl = document.getElementById('game-instruction');
            if (instructionEl) instructionEl.innerText = mission.instruction;
            if (instructionContainer) {
                if (mission.id === 1) {
                    instructionContainer.classList.add('hidden');
                } else {
                    instructionContainer.classList.remove('hidden');
                }
            }

            // Audio narración (sin solapamiento)
            playMissionAudio(mission.audio);

            // Escenario
            const stage = document.getElementById('game-stage')!;
            stage.style.pointerEvents = 'auto';
            stage.innerHTML = '';

            switch (mission.id) {
                case 1: renderMission1(stage); break;
                case 2: renderMission2(stage); break;
                case 3: renderMission3(stage); break;
                case 4: renderMission4(stage); break;
                case 5: renderMission5(stage); break;
                case 6: renderMission6(stage); break;
                case 7: renderMission7(stage); break;
                case 8: renderMission8(stage); break;
            }
        }

        // ==========================================
        // MINI-JUEGO 1: La botella perdida
        // ==========================================
        function renderMission1(stage: HTMLElement) {
            clearMission1Timers();

            stage.innerHTML = `
                <div id="m1-container" class="w-full h-full flex flex-row items-center justify-between relative px-4 sm:px-10 py-2 select-none overflow-hidden touch-none">
                    
                    <!-- Efectos de celebración: Destellos dorados y Burbujas -->
                    <div id="m1-celebration-effects" class="pointer-events-none absolute inset-0 z-30 flex items-center justify-center hidden">
                        <img id="m1-sparkles" src="/images/juego 1 destellos.png" alt="Destellos dorados" class="absolute right-4 sm:right-12 w-48 sm:w-64 h-auto object-contain pointer-events-none">
                        <img id="m1-bubbles" src="/images/juego 1 burbujas.png" alt="Burbujas" class="absolute right-2 sm:right-10 w-44 sm:w-60 h-auto object-contain pointer-events-none">
                    </div>

                    <!-- Puntero animado (Mano blanca con contorno azul) -->
                    <div id="m1-pointer" class="pointer-events-none absolute z-40 opacity-0 transition-opacity duration-300">
                        <img src="/images/juego 1.png" alt="Puntero de ayuda" class="w-12 sm:w-16 h-auto object-contain drop-shadow-2xl rotate-[-10deg]">
                    </div>

                    <!-- Botella grande con balanceo suave inicial -->
                    <div id="m1-bottle-wrapper" class="relative z-20 flex flex-col items-center select-none touch-none">
                        <div id="m1-bottle" class="cursor-grab active:cursor-grabbing p-2 transition-transform duration-150 animate-bottle-sway flex items-center justify-center touch-none">
                            <img id="m1-bottle-img" src="/images/Juego 1 Botella.png" alt="Botella de plástico" class="w-28 sm:w-40 max-h-[190px] sm:max-h-[250px] object-contain drop-shadow-2xl pointer-events-none">
                        </div>
                    </div>

                    <!-- Tacho verde grande -->
                    <div id="m1-bin-wrapper" class="relative z-10 flex flex-col items-center select-none cursor-pointer p-2">
                        <div id="m1-bin" class="flex flex-col items-center transition-transform duration-250 transform-gpu">
                            <img id="m1-bin-img" src="/images/juego 1 tacho cerrado.png" alt="Tacho verde" class="w-32 sm:w-48 max-h-[190px] sm:max-h-[250px] object-contain drop-shadow-2xl pointer-events-none">
                        </div>
                    </div>

                </div>
            `;

            const container = document.getElementById('m1-container')!;
            const bottle = document.getElementById('m1-bottle')!;
            const bin = document.getElementById('m1-bin')!;
            const binImg = document.getElementById('m1-bin-img') as HTMLImageElement;
            const pointer = document.getElementById('m1-pointer')!;

            let isWon = false;
            let isSelected = false;
            let isDragging = false;
            let isPointerDown = false;
            let hasInteracted = false;
            let startX = 0;
            let startY = 0;

            // Función para detener el puntero animado si el niño interactúa
            const stopHandPointer = () => {
                if (m1HandTimeout) {
                    clearTimeout(m1HandTimeout);
                    m1HandTimeout = null;
                }
                if (pointer) {
                    pointer.style.transition = 'opacity 0.25s ease';
                    pointer.style.opacity = '0';
                }
            };

            // Programar repetición del puntero cada 7 segundos de inactividad
            const resetIdleTimer = () => {
                if (m1IdleTimer) clearTimeout(m1IdleTimer);
                if (!isWon) {
                    m1IdleTimer = setTimeout(() => {
                        runPointerDemonstration();
                    }, 7000);
                }
            };

            // Demostración del recorrido con la mano blanca animada
            const runPointerDemonstration = () => {
                if (isWon || isPointerDown || isDragging || !pointer || !container || !bottle || !bin) return;

                stopHandPointer();

                const cRect = container.getBoundingClientRect();
                const bRect = bottle.getBoundingClientRect();
                const tRect = bin.getBoundingClientRect();

                // Coordenadas relativas al contenedor
                const startBottleX = (bRect.left + bRect.width * 0.5) - cRect.left;
                const startBottleY = (bRect.top + bRect.height * 0.45) - cRect.top;
                const targetBinX = (tRect.left + tRect.width * 0.5) - cRect.left;
                const targetBinY = (tRect.top + tRect.height * 0.35) - cRect.top;

                // 1. La mano aparece cerca de la botella
                pointer.style.transition = 'none';
                pointer.style.left = `${startBottleX}px`;
                pointer.style.top = `${startBottleY}px`;
                pointer.style.transform = 'translate(-40%, -30%) scale(1.1)';
                pointer.style.opacity = '0';

                requestAnimationFrame(() => {
                    pointer.style.transition = 'opacity 0.4s ease';
                    pointer.style.opacity = '1';

                    // 2. Se desplaza lentamente desde la botella hasta el tacho verde
                    m1HandTimeout = setTimeout(() => {
                        if (isWon || isPointerDown) return;

                        const moveDistX = targetBinX - startBottleX;
                        const moveDistY = targetBinY - startBottleY;

                        pointer.style.transition = 'transform 2.2s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s ease';
                        pointer.style.transform = `translate(calc(-40% + ${moveDistX}px), calc(-30% + ${moveDistY}px)) scale(0.98)`;

                        // 3. Después de mostrar el recorrido, desaparece suavemente
                        m1HandTimeout = setTimeout(() => {
                            if (isWon || isPointerDown) return;
                            pointer.style.opacity = '0';

                            m1HandTimeout = setTimeout(() => {
                                pointer.style.transition = 'none';
                                resetIdleTimer();
                            }, 500);
                        }, 2250);
                    }, 400);
                });
            };

            // La demostración se realiza una vez al comenzar la actividad
            setTimeout(() => {
                if (!hasInteracted && !isWon) {
                    runPointerDemonstration();
                }
            }, 800);

            // Secuencia de respuesta correcta oficial
            const executeCorrectAnswer = () => {
                if (isWon) return;
                isWon = true;

                clearMission1Timers();
                stopHandPointer();

                // Desactivar interacción temporal
                stage.style.pointerEvents = 'none';

                // 1. El tacho abre su tapa y aumenta tamaño
                binImg.src = '/images/juego 1 tacho abierto.png';
                bin.classList.add('scale-110');

                // 2. La botella se mueve hacia su interior y desaparece
                const bRect = bottle.getBoundingClientRect();
                const tRect = bin.getBoundingClientRect();
                const deltaX = (tRect.left + tRect.width / 2) - (bRect.left + bRect.width / 2);
                const deltaY = (tRect.top + tRect.height * 0.38) - (bRect.top + bRect.height / 2);

                bottle.style.transition = 'transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.55s ease';
                bottle.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(0.18) rotate(32deg)`;
                bottle.style.opacity = '0';

                // 3. Cuando la botella entra completamente:
                setTimeout(() => {
                    // El tacho cierra su tapa
                    binImg.src = '/images/juego 1 tacho cerrado.png';
                    bin.classList.remove('scale-110');

                    // Pequeño salto de celebración
                    bin.classList.add('animate-bin-jump');

                    // Aparecen estrellas doradas y algunas burbujas
                    const effects = document.getElementById('m1-celebration-effects');
                    const sparkles = document.getElementById('m1-sparkles');
                    const bubbles = document.getElementById('m1-bubbles');

                    if (effects) effects.classList.remove('hidden');
                    if (sparkles) sparkles.classList.add('animate-sparkle-burst');
                    if (bubbles) bubbles.classList.add('animate-bubble-float');

                    // Se muestra la estrella feliz animada y felicitación
                    setTimeout(() => {
                        celebrateMission(MISSIONS[0].successMessage);
                    }, 650);
                }, 650);
            };

            // Manejo de Interacción: Opción A (Arrastrar y Soltar) & Opción B (Tocar y Seleccionar)
            bottle.addEventListener('pointerdown', (e: PointerEvent) => {
                if (isWon) return;
                hasInteracted = true;
                stopHandPointer();
                if (m1IdleTimer) clearTimeout(m1IdleTimer);

                // La animación de balanceo se detiene cuando el niño interactúa
                bottle.classList.remove('animate-bottle-sway');

                isPointerDown = true;
                isDragging = false;
                startX = e.clientX;
                startY = e.clientY;

                try {
                    bottle.setPointerCapture(e.pointerId);
                } catch (_) {}

                bottle.style.transition = 'none';
            });

            bottle.addEventListener('pointermove', (e: PointerEvent) => {
                if (!isPointerDown || isWon) return;

                const diffX = e.clientX - startX;
                const diffY = e.clientY - startY;

                // Si se mueve más de 6px se convierte en arrastre
                if (Math.hypot(diffX, diffY) > 6) {
                    isDragging = true;
                    isSelected = false;
                    bottle.classList.remove('bottle-selected-glow');

                    // La botella sigue el movimiento de forma fluida
                    bottle.style.transform = `translate(${diffX}px, ${diffY}px) scale(1.08) rotate(5deg)`;

                    // Verificación de proximidad con el tacho
                    const bRect = bottle.getBoundingClientRect();
                    const tRect = bin.getBoundingClientRect();
                    const distX = Math.abs((bRect.left + bRect.width / 2) - (tRect.left + tRect.width / 2));
                    const distY = Math.abs((bRect.top + bRect.height / 2) - (tRect.top + tRect.height / 2));

                    // Cuando se acerca al tacho, este aumenta ligeramente y abre su tapa
                    if (distX < (tRect.width * 0.85) && distY < (tRect.height * 0.95)) {
                        binImg.src = '/images/juego 1 tacho abierto.png';
                        bin.classList.add('scale-110');
                    } else {
                        binImg.src = '/images/juego 1 tacho cerrado.png';
                        bin.classList.remove('scale-110');
                    }
                }
            });

            const onPointerRelease = (e: PointerEvent) => {
                if (!isPointerDown || isWon) return;
                isPointerDown = false;

                try {
                    bottle.releasePointerCapture(e.pointerId);
                } catch (_) {}

                if (isDragging) {
                    isDragging = false;
                    const bRect = bottle.getBoundingClientRect();
                    const tRect = bin.getBoundingClientRect();
                    const distX = Math.abs((bRect.left + bRect.width / 2) - (tRect.left + tRect.width / 2));
                    const distY = Math.abs((bRect.top + bRect.height / 2) - (tRect.top + tRect.height / 2));

                    // Al soltar la botella sobre el tacho, se activa la respuesta correcta
                    if (distX < (tRect.width * 0.85) && distY < (tRect.height * 0.95)) {
                        executeCorrectAnswer();
                    } else {
                        // 6. Si suelta la botella fuera del tacho:
                        // La botella regresa suavemente a su posición original sin cruces ni ruidos negativos
                        bottle.style.transition = 'transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
                        bottle.style.transform = 'translate(0px, 0px) scale(1) rotate(0deg)';
                        binImg.src = '/images/juego 1 tacho cerrado.png';
                        bin.classList.remove('scale-110');

                        // Reanudar suave balanceo y programar repetición del puntero tras 7s
                        setTimeout(() => {
                            if (!isWon && !isSelected && !isPointerDown) {
                                bottle.classList.add('animate-bottle-sway');
                            }
                        }, 480);
                        resetIdleTimer();
                    }
                } else {
                    // Opción B: Tocar y seleccionar
                    // El niño toca la botella, queda seleccionada y muestra un brillo suave
                    isSelected = true;
                    bottle.classList.remove('animate-bottle-sway');
                    bottle.classList.add('bottle-selected-glow');

                    // El tacho abre su tapa suavemente como indicación
                    binImg.src = '/images/juego 1 tacho abierto.png';
                    bin.classList.add('scale-105');

                    resetIdleTimer();
                }
            };

            bottle.addEventListener('pointerup', onPointerRelease);
            bottle.addEventListener('pointercancel', onPointerRelease);

            // Toque en el tacho verde (Opción B: Toca la botella seleccionada -> toca el tacho verde)
            bin.addEventListener('click', () => {
                if (isWon) return;
                hasInteracted = true;
                stopHandPointer();

                if (isSelected) {
                    // Botella estaba seleccionada: se activa la animación de respuesta correcta
                    executeCorrectAnswer();
                } else {
                    // Si el niño toca directo el tacho sin haber tocado la botella, mostrar demostración
                    runPointerDemonstration();
                }
            });
        }

        // ==========================================
        // MINI-JUEGO 2: El río feliz
        // ==========================================
        function renderMission2(stage: HTMLElement) {
            clearMission2Timers();

            stage.innerHTML = `
