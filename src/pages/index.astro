            const sparkles = document.getElementById('m2-clean-sparkles')!;
            const dirtyParticles = document.getElementById('m2-dirty-particles')!;
            const dirtyTitle = document.getElementById('m2-dirty-title')!;

            let isWon = false;
            let hasInteracted = false;

            const stopHandPointer = () => {
                if (m2HandTimeout) {
                    clearTimeout(m2HandTimeout);
                    m2HandTimeout = null;
                }
                if (cleanBtn) {
                    cleanBtn.style.transform = '';
                    cleanBtn.style.boxShadow = '';
                }
                if (dirtyBtn) {
                    dirtyBtn.style.transform = '';
                    dirtyBtn.style.boxShadow = '';
                }
                if (pointer) {
                    pointer.style.transition = 'opacity 0.25s ease';
                    pointer.style.opacity = '0';
                }
            };

            const resetIdleTimer = () => {
                if (m2IdleTimer) clearTimeout(m2IdleTimer);
                if (!isWon) {
                    m2IdleTimer = setTimeout(() => {
                        runPointerDemonstration();
                    }, 7000);
                }
            };

            // Efectos suaves al pasar sobre cada imagen
            cleanBtn.addEventListener('pointerenter', () => {
                if (!isWon) cleanBtn.style.transform = 'scale(1.06)';
            });
            cleanBtn.addEventListener('pointerleave', () => {
                if (!isWon) cleanBtn.style.transform = '';
            });
            dirtyBtn.addEventListener('pointerenter', () => {
                if (!isWon) dirtyBtn.style.transform = 'scale(1.06)';
            });
            dirtyBtn.addEventListener('pointerleave', () => {
                if (!isWon) dirtyBtn.style.transform = '';
            });

            // Demostración visual: La mano pasa por cada imagen haciéndola grande y regresándola a su estado normal
            const runPointerDemonstration = () => {
                if (isWon || !pointer || !container || !cleanBtn || !dirtyBtn) return;

                stopHandPointer();

                const cRect = container.getBoundingClientRect();
                const cleanRect = cleanBtn.getBoundingClientRect();
                const dirtyRect = dirtyBtn.getBoundingClientRect();

                const cleanX = (cleanRect.left + cleanRect.width * 0.5) - cRect.left;
                const dirtyX = (dirtyRect.left + dirtyRect.width * 0.5) - cRect.left;
                const cardY = (cleanRect.top + cleanRect.height * 0.5) - cRect.top;

                // 1. Aparece sobre la primera imagen y la hace grande
                pointer.style.transition = 'none';
                pointer.style.left = `${cleanX}px`;
                pointer.style.top = `${cardY}px`;
                pointer.style.transform = 'translate(-50%, -50%) scale(1.05)';
                pointer.style.opacity = '0';

                cleanBtn.style.transition = 'transform 0.4s ease, box-shadow 0.4s ease';
                dirtyBtn.style.transition = 'transform 0.4s ease, box-shadow 0.4s ease';

                requestAnimationFrame(() => {
                    pointer.style.transition = 'opacity 0.4s ease';
                    pointer.style.opacity = '1';
                    cleanBtn.style.transform = 'scale(1.08)';
                    cleanBtn.style.boxShadow = '0 12px 28px rgba(16,185,129,0.35)';

                    // 2. Se quita el puntero de la primera (vuelve a su estado normal) y se desplaza a la segunda (se hace grande)
                    m2HandTimeout = setTimeout(() => {
                        if (isWon) return;

                        cleanBtn.style.transform = '';
                        cleanBtn.style.boxShadow = '';

                        pointer.style.transition = 'left 1.4s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease';
                        pointer.style.left = `${dirtyX}px`;

                        m2HandTimeout = setTimeout(() => {
                            if (isWon) return;

                            dirtyBtn.style.transform = 'scale(1.08)';
                            dirtyBtn.style.boxShadow = '0 12px 28px rgba(100,116,139,0.35)';

                            // 3. Quita el puntero, la segunda vuelve a su estado normal y el puntero desaparece suavemente
                            m2HandTimeout = setTimeout(() => {
                                if (isWon) return;

                                dirtyBtn.style.transform = '';
                                dirtyBtn.style.boxShadow = '';

                                const midX = (cleanX + dirtyX) / 2;
                                pointer.style.transition = 'left 1.1s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s ease';
                                pointer.style.left = `${midX}px`;
                                pointer.style.opacity = '0';

                                m2HandTimeout = setTimeout(() => {
                                    pointer.style.transition = 'none';
                                    resetIdleTimer();
                                }, 500);
                            }, 1400);
                        }, 700);
                    }, 1200);
                });
            };

            // Demostración inicial tras presentación
            setTimeout(() => {
                if (!hasInteracted && !isWon) {
                    runPointerDemonstration();
                }
            }, 800);

            // Respuesta correcta: Río Limpio
            cleanBtn.addEventListener('click', () => {
                if (isWon) return;
                isWon = true;
                hasInteracted = true;

                clearMission2Timers();
                stopHandPointer();

                // 1. Agrandar ligeramente y contorno verde luminoso
                cleanBtn.classList.add('scale-105', 'ring-4', 'ring-emerald-400', 'border-emerald-400', 'shadow-[0_0_30px_rgba(16,185,129,0.8)]');

                // 2. Aumentar luminosidad del agua suavemente
                if (cleanImg) {
                    cleanImg.style.filter = 'brightness(1.18)';
                }

                // 3. Mostrar burbujas adicionales ascendiendo
                if (extraBubbles) {
                    extraBubbles.classList.remove('hidden');
                }

                // 4. Hacer aparecer pequeño arcoíris sobre la parte superior sin tapar peces
                if (rainbow) {
                    rainbow.classList.remove('opacity-0', 'scale-50');
                    rainbow.classList.add('animate-rainbow-pop');
                }

                // 5. Destellos dorados durante la celebración
                if (sparkles) {
                    sparkles.classList.add('animate-sparkle-burst');
                }

                // 6. Atenuar ligeramente la tarjeta del río sucio
                dirtyBtn.classList.add('opacity-40', 'scale-95');

                // 7. Mostrar la estrella de felicitación y reproducir audio final
                setTimeout(() => {
                    celebrateMission(MISSIONS[1].successMessage);
                }, 750);
            });

            // Respuesta incorrecta: Río Sucio
            dirtyBtn.addEventListener('click', () => {
                if (isWon) return;
                hasInteracted = true;
                stopHandPointer();

                // 1. Movimiento lateral suave durante 0.4s
                dirtyBtn.classList.add('animate-gentle-shake');

                // 2. Contorno naranja por un instante
                dirtyBtn.classList.add('ring-4', 'ring-amber-400', 'border-amber-400');
                if (dirtyTitle) {
                    dirtyTitle.classList.remove('bg-slate-700');
                    dirtyTitle.classList.add('bg-amber-600');
                }

                // 3. Aumentar brevemente el movimiento de partículas
                if (dirtyParticles) {
                    dirtyParticles.style.animationDuration = '1.8s';
                }

                // 4. Regresar suavemente a la apariencia original y permitir volver a intentar
                setTimeout(() => {
                    dirtyBtn.classList.remove('animate-gentle-shake', 'ring-4', 'ring-amber-400', 'border-amber-400');
                    if (dirtyTitle) {
                        dirtyTitle.classList.remove('bg-amber-600');
                        dirtyTitle.classList.add('bg-slate-700');
                    }
                    if (dirtyParticles) {
                        dirtyParticles.style.animationDuration = '6s';
                    }
                    resetIdleTimer();
                }, 450);
            });
        }

