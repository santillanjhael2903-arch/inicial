            let hasInteracted = false;
            let m4IdleTimer: any = null;
            let m4HandTimeout: any = null;

            // Intercambiar posiciones cada 3 segundos para que sea más dinámico y animado
            const cards = [btnBottle, btnFish, btnAlgae];
            let currentOrders = [1, 2, 3];
