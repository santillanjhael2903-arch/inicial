---

<section id="screen-results" class="relative z-10 w-[90%] max-w-lg glass-panel rounded-[2.5rem] p-8 text-center hidden flex-col items-center">
    <div id="result-icon" class="text-7xl mb-2 drop-shadow-md">🏆</div>
    <h2 id="result-title" class="text-4xl font-black text-slate-800 mb-1">ECO HÉROE</h2>
    
    <div class="my-6 w-full bg-white/60 rounded-2xl p-4 border border-slate-200">
        <p class="text-slate-500 font-bold text-sm uppercase tracking-wider mb-1">Puntuación Final</p>
        <div class="text-5xl font-black text-emerald-500" id="result-score">8/8</div>
    </div>

    <p id="result-msg" class="text-slate-600 font-bold mb-8 text-lg">
        ¡Felicidades! Has completado el desafío.
    </p>

    <button id="btn-restart" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-black text-xl py-4 rounded-2xl shadow-[0_8px_0_rgb(15,23,42)] active:shadow-[0_0px_0_rgb(15,23,42)] active:translate-y-2 transition-all flex justify-center items-center gap-2">
        <i class="fa-solid fa-rotate-left"></i> Volver al inicio
    </button>
</section>
