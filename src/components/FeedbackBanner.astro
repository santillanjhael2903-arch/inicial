---
---

<div id="feedback-banner" class="fixed bottom-0 left-0 w-full transform translate-y-full transition-transform duration-300 ease-in-out z-50">
    <div id="feedback-bg" class="w-full min-h-[160px] bg-emerald-500 rounded-t-[2rem] shadow-[0_-10px_20px_rgba(0,0,0,0.15)] p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 text-white w-full md:w-auto">
            <div id="feedback-icon" class="text-5xl bg-white/20 rounded-full w-16 h-16 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-check"></i>
            </div>
            <div>
                <h3 id="feedback-title" class="text-2xl font-black">¡Muy bien!</h3>
                <p id="feedback-desc" class="text-lg font-semibold opacity-90">Sigue así.</p>
            </div>
        </div>
        <!-- Visual indicator of auto-advance -->
        <div class="hidden md:flex bg-white/20 text-white px-4 py-2 rounded-xl font-bold text-sm items-center gap-2">
            <i class="fa-solid fa-spinner fa-spin"></i> Avanzando...
        </div>
    </div>
</div>
