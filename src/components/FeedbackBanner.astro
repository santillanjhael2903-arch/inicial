---
---

<div id="feedback-banner" class="fixed bottom-1.5 sm:bottom-3 left-0 w-full transform translate-y-full transition-transform duration-300 ease-in-out z-50 pointer-events-none px-3 sm:px-4">
    <div id="feedback-bg" class="w-full max-w-sm sm:max-w-md mx-auto min-h-[64px] sm:min-h-[72px] bg-emerald-500 rounded-2xl shadow-[0_8px_30px_rgba(0,0,0,0.3)] p-2 sm:p-3 flex flex-row items-center justify-between gap-2.5 pointer-events-auto border-2 border-white/30">
        <div class="flex items-center gap-2 sm:gap-3 text-white flex-1 min-w-0">
            <img id="feedback-mascot" src="/images/FELICITA.png" alt="Mascota" class="object-contain shrink-0 drop-shadow-md" style="width: 42px; height: 42px; max-width: 42px; max-height: 42px;">
            <div class="min-w-0 flex-1">
                <h3 id="feedback-title" class="text-xs sm:text-sm font-black leading-tight">¡Muy bien!</h3>
                <p id="feedback-desc" class="text-[10px] sm:text-xs font-bold opacity-95 line-clamp-2 leading-tight">Sigue así.</p>
            </div>
        </div>
        <!-- Indicador visual de auto-avance -->
        <div class="bg-white/25 text-white px-2 py-1 rounded-xl font-black text-[10px] sm:text-xs flex items-center gap-1 shrink-0">
            <i class="fa-solid fa-spinner fa-spin text-[10px]"></i>
            <span class="hidden xs:inline">Avanzando...</span>
        </div>
    </div>
</div>
