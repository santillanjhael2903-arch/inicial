---
---

<section id="screen-start" class="relative z-10 w-[92%] max-w-md glass-panel rounded-3xl sm:rounded-[2rem] p-5 sm:p-7 md:p-8 text-center flex flex-col items-center max-h-[95dvh] overflow-y-auto">
    <img src="/images/saluda.png" alt="Eco-Explorador saludando" class="w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 object-contain mb-3 sm:mb-4 drop-shadow-md">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-800 mb-1.5 sm:mb-2 tracking-tight">EcoGuardianes</h1>
    <p class="text-sm sm:text-base md:text-lg text-slate-600 font-bold mb-4 sm:mb-5">Aprende jugando y protege el planeta</p>
    
    <!-- Input para nombre de la persona (Centrado armónicamente con el diseño) -->
    <div class="w-full mb-4 sm:mb-5 text-center flex flex-col items-center">
        <label for="player-name" class="text-xs font-black uppercase tracking-wider text-slate-600 mb-2 flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-id-card text-emerald-600"></i> ¿Cómo te llamas, Eco-Explorador?
        </label>
        <input 
            type="text" 
            id="player-name" 
            placeholder="Escribe tu nombre aquí..." 
            maxlength="30"
            autocomplete="name"
            class="w-full bg-white/95 border-2 border-b-4 border-slate-300 rounded-2xl px-4 py-3 font-extrabold text-base sm:text-lg text-slate-800 placeholder:text-slate-400 text-center focus:outline-none focus:border-emerald-500 focus:border-b-emerald-700 transition-all shadow-sm"
        />
        <p id="name-error" class="hidden text-xs font-bold text-rose-600 mt-2 text-center flex items-center justify-center gap-1">
            <i class="fa-solid fa-circle-exclamation"></i> Por favor, escribe tu nombre para comenzar la aventura.
        </p>
    </div>

    <button id="btn-start" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black text-lg sm:text-xl py-3.5 sm:py-4 rounded-2xl border-b-4 border-emerald-700 shadow-md active:border-b-2 active:translate-y-1 transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span>Comenzar aventura</span>
        <i class="fa-solid fa-arrow-right text-base"></i>
    </button>
</section>
