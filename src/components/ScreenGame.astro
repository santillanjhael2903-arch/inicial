---
---

<section id="screen-game" class="relative z-10 w-full h-full hidden flex-col justify-between pt-6 pb-0">
    
    <!-- Header Progress -->
    <div class="w-[90%] max-w-2xl mx-auto flex items-center gap-4 bg-white/95 backdrop-blur-sm p-4 rounded-2xl shadow-md">
        <i id="btn-close-game" class="fa-solid fa-xmark text-slate-400 text-xl cursor-pointer hover:text-slate-600"></i>
        <div class="flex-1 h-4 bg-slate-200 rounded-full overflow-hidden">
            <div id="game-progress" class="h-full bg-emerald-500 rounded-full transition-all duration-500 w-0"></div>
        </div>
        <span id="game-counter" class="font-black text-emerald-600">1/8</span>
    </div>

    <!-- Question Area (Duolingo Style: Mascot on the side + Speech Bubble) -->
    <div class="w-[90%] max-w-2xl mx-auto flex-1 flex flex-col justify-center gap-4 overflow-y-auto py-3">
        <div class="flex items-end gap-3 sm:gap-4 w-full">
            <!-- Mascota al costado -->
            <div class="shrink-0 flex flex-col items-center">
                <img src="/images/pensativo.png" alt="Bagre pensativo" class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 object-contain drop-shadow-xl animate-bounce-subtle">
            </div>

            <!-- Globo de diálogo estilo Duolingo con alto contraste al verde -->
            <div class="relative flex-1 bg-white/95 backdrop-blur-md p-5 sm:p-6 rounded-[2rem] rounded-bl-sm border-2 border-sky-400 shadow-[0_8px_25px_-5px_rgba(14,165,233,0.3)]">
                <!-- Flecha/piquito apuntando a la mascota -->
                <div class="absolute -left-2.5 bottom-4 w-0 h-0 border-t-[8px] border-t-transparent border-r-[12px] border-r-white border-b-[8px] border-b-transparent"></div>
                
                <div class="flex items-center gap-2 mb-1.5">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black bg-sky-100 text-sky-800 tracking-wider uppercase border border-sky-300">
                        <i class="fa-solid fa-cloud-sun text-sky-600 mr-1.5"></i> Pregunta Eco-Explorador
                    </span>
                </div>
                <h2 id="game-question" class="text-xl sm:text-2xl md:text-2xl font-black text-blue-950 leading-snug tracking-tight drop-shadow-sm">¿Pregunta?</h2>
            </div>
        </div>
        
        <div id="game-options" class="flex flex-col gap-2.5 sm:gap-3">
            <!-- Options injected via JS -->
        </div>
    </div>
</section>
