---
---

<section id="screen-game" class="relative z-10 w-full h-full min-h-[100dvh] max-h-[100dvh] hidden flex-col items-center justify-start pt-2 sm:pt-3.5 pb-24 sm:pb-28 px-3 sm:px-6 select-none overflow-hidden">
    
    <!-- ========================================================================= -->
    <!-- ELEMENTOS DECORATIVOS ADAPTADOS PARA MÓVILES (Snoopy, tachos, letreros y árboles) -->
    <!-- Se ajustan a los bordes y reducen su escala en celular para no tapar opciones -->
    <!-- ========================================================================= -->

    <!-- Esquina superior izquierda: Árbol y letrero de madera 'Cuidar hoy, un mejor mañana' -->
    <div class="md:hidden pointer-events-none fixed top-0 left-0 z-0 w-22 sm:w-28 max-h-[140px] overflow-hidden opacity-90">
        <img src="/images/mobile-sign-left.png" alt="Letrero cuidar hoy" class="w-full h-auto object-contain">
    </div>

    <!-- Esquina superior derecha: Árbol, Woodstock y letrero 'Planta árboles, siembra vida' -->
    <div class="md:hidden pointer-events-none fixed top-0 right-0 z-0 w-22 sm:w-28 max-h-[140px] overflow-hidden opacity-90">
        <img src="/images/mobile-sign-right.png" alt="Letrero planta árboles" class="w-full h-auto object-contain">
    </div>

    <!-- Esquina inferior izquierda: Snoopy con bolsa ecológica y los 3 tachos de reciclaje -->
    <div class="md:hidden pointer-events-none fixed bottom-0 left-0 z-0 w-28 sm:w-36 max-h-[170px] overflow-hidden opacity-95">
        <img src="/images/mobile-snoopy-bins.png" alt="Snoopy reciclando con tachos" class="w-full h-auto object-contain">
    </div>

    <!-- Esquina inferior derecha: Snoopy plantando un árbol y piedra de cambios -->
    <div class="md:hidden pointer-events-none fixed bottom-0 right-0 z-0 w-28 sm:w-36 max-h-[170px] overflow-hidden opacity-95">
        <img src="/images/mobile-snoopy-planting.png" alt="Snoopy plantando un árbol" class="w-full h-auto object-contain">
    </div>

    <!-- Top Header Progress (Exact Duolingo capsule as in reference screenshots) -->
    <div class="relative z-20 w-full max-w-sm sm:max-w-md mx-auto flex items-center gap-2.5 bg-white/95 backdrop-blur-sm rounded-full px-3.5 py-1.5 shadow-sm border border-slate-200/80 shrink-0 mb-1 sm:mb-2">
        <button id="btn-close-game" aria-label="Cerrar juego" class="text-slate-400 hover:text-slate-700 text-base p-0.5 transition-colors flex items-center justify-center font-bold cursor-pointer">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>
        <div class="flex-1 h-2 sm:h-2.5 bg-slate-200/90 rounded-full overflow-hidden">
            <div id="game-progress" class="h-full bg-emerald-500 rounded-full transition-all duration-300 w-0"></div>
        </div>
        <span id="game-counter" class="font-extrabold text-xs sm:text-sm text-emerald-600 shrink-0">1 de 8</span>
    </div>

    <!-- Main Game Canvas (Duolingo Layout: Title + Mascot & Green Speech Bubble + Centered Options) -->
    <div class="relative z-20 w-full max-w-sm sm:max-w-md mx-auto flex flex-col items-center gap-1.5 sm:gap-2.5 shrink-0 mt-0.5">
        
        <!-- Duolingo Instruction Title with Bullet Dot -->
        <h2 class="text-xs sm:text-sm md:text-base font-extrabold text-[#0f3057] text-center tracking-tight flex items-center justify-center gap-1.5 shrink-0 bg-white/60 backdrop-blur-[2px] px-3 py-0.5 rounded-full shadow-xs">
            <span class="text-emerald-500 font-black text-base">•</span>
            <span id="game-title-text">¡Vamos, Eco-Explorador! Escoge la respuesta correcta</span>
        </h2>

        <!-- Mascot & Speech Bubble Scene (Con dimensiones fijas exactas para celular y escritorio) -->
        <div class="flex items-center gap-2 sm:gap-3 w-full justify-center shrink-0 my-0.5">
            <!-- Mascota con sombrero de explorador (Estricto: 60px celular / 72px escritorio) -->
            <div class="shrink-0 flex items-center justify-center" style="width: 60px; height: 60px; min-width: 60px; max-width: 60px;">
                <img src="/images/pensativo.png" alt="Bagre explorador" class="drop-shadow-md" style="width: 60px; height: 60px; max-width: 60px; max-height: 60px; object-fit: contain;">
            </div>

            <!-- Globo de diálogo VERDE Duolingo con piquito apuntando a la izquierda -->
            <div class="relative flex-1 min-w-0 bg-[#008f5d] text-white py-2 px-3 sm:py-3 sm:px-4 rounded-2xl rounded-bl-sm shadow-md border border-emerald-700">
                <!-- Piquito que conecta con la mascota -->
                <div class="absolute -left-2 bottom-3 w-0 h-0 border-t-[5px] border-t-transparent border-r-[8px] border-r-[#008f5d] border-b-[5px] border-b-transparent"></div>
                
                <h3 id="game-question" class="text-xs sm:text-sm md:text-base font-extrabold text-white leading-snug break-words">¿Pregunta?</h3>
            </div>
        </div>
        
        <!-- Options container (4 centered white cards with numbers 1, 2, 3, 4) -->
        <div id="game-options" class="flex flex-col gap-1.5 sm:gap-2 w-full shrink-0">
            <!-- Options injected via JS -->
        </div>
    </div>
</section>
