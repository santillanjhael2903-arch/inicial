---
---

<section id="screen-game" class="relative z-10 w-full h-full min-h-[100dvh] max-h-[100dvh] hidden flex-col justify-between items-center select-none overflow-hidden py-2 sm:py-3 px-2 sm:px-4">
    
    <!-- Decoraciones laterales en bordes -->
    <div class="pointer-events-none fixed top-0 left-0 z-0 w-16 sm:w-28 max-h-[90px] sm:max-h-[140px] overflow-hidden opacity-75 sm:opacity-90">
        <img src="/images/mobile-sign-left.png" alt="Letrero cuidar hoy" class="w-full h-auto object-contain">
    </div>

    <div class="pointer-events-none fixed top-0 right-0 z-0 w-16 sm:w-28 max-h-[90px] sm:max-h-[140px] overflow-hidden opacity-75 sm:opacity-90">
        <img src="/images/mobile-sign-right.png" alt="Letrero planta árboles" class="w-full h-auto object-contain">
    </div>

    <div class="pointer-events-none fixed bottom-0 left-0 z-0 w-20 sm:w-36 max-h-[110px] sm:max-h-[170px] overflow-hidden opacity-80 sm:opacity-95">
        <img src="/images/mobile-snoopy-bins.png" alt="Snoopy reciclando" class="w-full h-auto object-contain">
    </div>

    <div class="pointer-events-none fixed bottom-0 right-0 z-0 w-20 sm:w-36 max-h-[110px] sm:max-h-[170px] overflow-hidden opacity-80 sm:opacity-95">
        <img src="/images/mobile-snoopy-planting.png" alt="Snoopy plantando" class="w-full h-auto object-contain">
    </div>

    <!-- ===== TOP BAR: Barra de progreso + Botón de Audio ===== -->
    <div class="relative z-20 w-full max-w-lg mx-auto flex items-center gap-2 sm:gap-3 bg-white/95 backdrop-blur-md rounded-full px-3.5 py-1.5 sm:py-2 shadow-md border border-slate-200 shrink-0">
        <button id="btn-close-game" aria-label="Cerrar juego" class="text-slate-400 hover:text-slate-700 text-base sm:text-lg p-1 transition-colors flex items-center justify-center font-bold cursor-pointer">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Barra de progreso Duolingo -->
        <div class="flex-1 h-3 sm:h-3.5 bg-slate-200/90 rounded-full overflow-hidden p-0.5">
            <div id="game-progress" class="h-full bg-emerald-500 rounded-full transition-all duration-500 w-0 shadow-inner"></div>
        </div>

        <span id="game-counter" class="font-black text-xs sm:text-sm text-emerald-700 shrink-0">1 de 8</span>

        <!-- Botón de Audio interactivo (Reproduce la narración de la misión) -->
        <button id="btn-play-audio" title="Escuchar narración" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-sm border-2 border-emerald-600 active:scale-95 transition-all cursor-pointer shrink-0">
            <i id="audio-icon" class="fa-solid fa-volume-high text-xs sm:text-sm"></i>
        </button>
    </div>

    <!-- Audio Element -->
    <audio id="mission-audio" preload="auto" class="hidden"></audio>

    <!-- ===== CONTENEDOR PRINCIPAL DEL JUEGO ===== -->
    <div class="relative z-20 w-full max-w-lg mx-auto flex-1 flex flex-col justify-between items-center my-1.5 sm:my-2 gap-1.5 sm:gap-2">
        
        <!-- Header de la Misión: Mascota + Globo de diálogo verde + Indicación -->
        <div class="w-full flex flex-col items-center gap-1 shrink-0">
            <!-- Título de la misión y guía rápida -->
            <div class="flex items-center gap-2 w-full justify-center">
                <!-- Mascota Bagre -->
                <div class="shrink-0 flex items-center justify-center w-11 h-11 sm:w-14 sm:h-14">
                    <img id="game-mascot" src="/images/pensativo.png" alt="Bagre explorador" class="w-full h-full object-contain drop-shadow-md">
                </div>

                <!-- Globo de diálogo verde Duolingo -->
                <div class="relative flex-1 min-w-0 bg-[#008f5d] text-white py-2 px-3 sm:py-2.5 sm:px-4 rounded-2xl rounded-bl-sm shadow-md border-2 border-emerald-600">
                    <div class="absolute -left-2 bottom-3 w-0 h-0 border-t-[6px] border-t-transparent border-r-[9px] border-r-[#008f5d] border-b-[6px] border-b-transparent"></div>
                    <span id="game-mission-title" class="block text-[11px] font-black uppercase tracking-wider text-emerald-200">1. La botella perdida</span>
                    <h3 id="game-question" class="text-xs sm:text-sm md:text-base font-extrabold text-white leading-snug break-words">¿Dónde debemos poner la botella?</h3>
                </div>
            </div>

            <!-- Pill de acción "¿Qué debes hacer?" (Oculto en juego 1 según instrucción) -->
            <div id="game-instruction-container" class="bg-amber-100/95 border border-amber-300 rounded-full px-3 py-0.5 sm:py-1 flex items-center gap-1.5 shadow-xs">
                <span class="text-xs">👉</span>
                <span id="game-instruction" class="text-[11px] sm:text-xs font-black text-amber-950">Arrastra o toca la botella hacia el tacho</span>
            </div>
        </div>
        
        <!-- ===== CONTENEDOR DEL ESCENARIO (Con fondo 'fondito.png' y modal centrado en su interior) ===== -->
        <div class="relative w-full flex-1 flex flex-col rounded-3xl sm:rounded-[2rem] overflow-hidden shadow-2xl border-4 border-emerald-500/40 min-h-[320px] sm:min-h-[400px]">
            <!-- Escenario interactivo dinámico -->
            <div id="game-stage" class="w-full h-full flex-1 p-2 sm:p-3 flex flex-col items-center justify-center relative overflow-hidden" style="background-image: url('/images/fondito.png'); background-size: 100% 100%; background-position: center; background-repeat: no-repeat;">
                <!-- Inyectado dinámicamente vía JS -->
            </div>

            <!-- ===== MODAL DE LA ESTRELLA DE FELICITACIÓN (Centrado en el medio del fondito) ===== -->
            <div id="game-star-modal" class="absolute inset-0 z-50 flex items-center justify-center bg-black/45 backdrop-blur-[2px] p-2.5 sm:p-4 hidden opacity-0 transition-opacity duration-300">
                <div class="bg-white rounded-3xl p-4 sm:p-5 max-w-[270px] sm:max-w-[310px] w-full text-center shadow-2xl border-4 border-amber-300 flex flex-col items-center transform scale-90 transition-transform duration-300" id="star-modal-card" style="background-color: #ffffff !important;">
                    <!-- Estrella Kawaii oficial animada -->
                    <div class="relative w-28 h-28 sm:w-36 sm:h-36 mb-1 animate-bounce-subtle">
                        <img src="/images/estrella de felicitacion.png" alt="¡Felicitaciones!" class="w-full h-full object-contain drop-shadow-xl">
                    </div>

                    <h3 class="text-xl sm:text-2xl font-black text-amber-500 mb-0.5 drop-shadow-xs">¡GENIAL!</h3>
                    <p id="star-success-message" class="text-xs sm:text-sm font-extrabold text-slate-800 mb-3.5 leading-snug">
                        ¡Muy bien! La basura va al tacho.
                    </p>

                    <button id="btn-next-mission" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black text-sm sm:text-base py-2.5 sm:py-3 px-4 rounded-2xl border-b-4 border-emerald-700 shadow-lg active:border-b-2 active:translate-y-1 transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <span>Siguiente misión</span>
                        <i class="fa-solid fa-arrow-right text-sm"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>

</section>
