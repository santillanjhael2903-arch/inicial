---
---

<section id="screen-upload" class="relative z-10 w-[92%] max-w-sm sm:max-w-md glass-panel rounded-3xl p-3.5 sm:p-5 text-center hidden flex-col items-center max-h-[94dvh] overflow-hidden">
    <h2 class="text-base sm:text-xl font-black text-slate-800 mb-0.5 leading-snug">¡Muestra tu acción por Cayhuaynita!</h2>
    <p class="text-slate-600 text-[11px] sm:text-xs font-semibold mb-2 leading-tight">Toma una foto reciclando o cuidando el río Huallaga.</p>
    
    <input type="file" id="file-input" accept="image/*" class="hidden">

    <!-- Dropzone (Estado Inicial) -->
    <div id="upload-dropzone" class="w-full border-2 border-dashed border-slate-300 rounded-2xl p-4 sm:p-5 hover:border-emerald-500 hover:bg-emerald-50/40 transition-all cursor-pointer flex flex-col items-center justify-center bg-white/70 shadow-sm">
        <div class="text-emerald-500 text-3xl mb-1"><i class="fa-solid fa-cloud-arrow-up"></i></div>
        <h3 class="font-black text-xs sm:text-sm text-slate-700">Toca o arrastra tu foto aquí</h3>
        <p class="text-slate-500 text-[10px] sm:text-[11px] mt-0.5">PNG, JPG — Máximo 5MB</p>
    </div>

    <!-- Loading -->
    <div id="upload-loading" class="hidden w-full p-4 flex-col items-center justify-center bg-white/70 rounded-2xl">
        <div class="spinner mb-2"></div>
        <p class="font-black text-xs sm:text-sm text-slate-600">Validando imagen ambiental con IA...</p>
    </div>

    <!-- Error (Rejection con mensaje exacto) -->
    <div id="upload-error" class="hidden w-full border-2 border-rose-300 bg-rose-50 p-3 rounded-2xl text-left shadow-sm">
        <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-circle-xmark text-rose-500 text-xl mt-0.5 shrink-0"></i>
            <div>
                <h4 class="font-black text-rose-800 text-xs sm:text-sm">Foto no válida</h4>
                <p id="upload-error-text" class="text-rose-700 text-xs font-bold my-1 leading-snug">
                    Sube la foto indicada.
                </p>
                <button id="btn-retry-upload" class="bg-white text-rose-700 font-black text-xs py-1 px-2.5 rounded-lg border border-rose-300 shadow-sm active:scale-95 transition-transform mt-0.5">
                    Intentar de nuevo
                </button>
            </div>
        </div>
    </div>

    <!-- Success (Todo visible sin deslizar) -->
    <div id="upload-success" class="hidden w-full flex-col items-center">
        <div class="w-full h-24 sm:h-28 bg-emerald-100 border-2 border-emerald-400 rounded-xl flex items-center justify-center mb-1.5 overflow-hidden relative shadow-sm">
            <img id="preview-img" class="w-full h-full object-cover opacity-60" src="" alt="preview">
            <div class="absolute inset-0 flex items-center justify-center flex-col text-emerald-900 drop-shadow-sm">
                <i class="fa-solid fa-check-circle text-2xl sm:text-3xl mb-0.5 text-emerald-600"></i>
                <span class="font-black text-xs sm:text-sm">Evidencia aceptada</span>
            </div>
        </div>

        <!-- Alerta de captura obligatoria de la foto (Exacto como pidió el usuario) -->
        <div class="w-full bg-amber-50 border border-amber-300 rounded-xl py-1.5 px-2.5 mb-2 text-left shadow-sm flex items-center gap-2">
            <span class="text-lg shrink-0">📸</span>
            <div>
                <h4 class="font-black text-amber-900 text-[11px] sm:text-xs leading-tight">¡No olvides tomar una captura de tu fotografía!</h4>
                <p class="text-amber-800 text-[10px] sm:text-[11px] font-bold mt-0.5 leading-tight">
                    Guárdala para luego reclamar tu Insignia de Eco-Explorador junto con tu puntuación final.
                </p>
            </div>
        </div>

        <button id="btn-start-game" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black text-sm sm:text-base py-2.5 rounded-xl border-b-4 border-emerald-700 shadow-md active:border-b-2 active:translate-y-1 transition-all mb-1">
            Iniciar desafío
        </button>

        <button id="btn-change-image" class="text-slate-500 hover:text-slate-700 font-bold text-xs py-0.5 transition-colors flex items-center gap-1">
            <i class="fa-solid fa-arrows-rotate text-[10px]"></i> Cambiar foto
        </button>
    </div>
</section>
