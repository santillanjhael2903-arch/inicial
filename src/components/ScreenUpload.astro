---
---

<section id="screen-upload" class="relative z-10 w-[94%] max-w-sm sm:max-w-md glass-panel rounded-3xl p-3.5 sm:p-5 text-center hidden flex-col items-center max-h-[94dvh] overflow-hidden">
    
    <!-- Botón discreto para configurar clave de Gemini API si el usuario lo desea -->
    <div class="w-full flex justify-end mb-1">
        <button id="btn-config-gemini" title="Configurar API Key de Gemini" class="text-[11px] font-extrabold text-emerald-800 bg-emerald-100 hover:bg-emerald-200 px-2.5 py-0.5 rounded-full border border-emerald-300 flex items-center gap-1 shadow-xs transition-colors">
            <i class="fa-solid fa-brain text-[10px]"></i> <span id="gemini-status-text">IA Gemini</span>
        </button>
    </div>

    <!-- Título y descripción completos como estaban antes -->
    <h2 class="text-base sm:text-xl font-black text-slate-800 mb-1 leading-snug tracking-tight">
        ¡Muestra tu acción por Cayhuaynita y el río Huallaga!
    </h2>
    <p class="text-slate-600 text-[11px] sm:text-xs font-semibold mb-1 leading-tight">
        Toma una foto reciclando o colocando correctamente la basura en el sector de Cayhuaynita.
    </p>
    <p class="text-emerald-700 text-[10px] sm:text-[11px] font-extrabold mb-2 flex items-center justify-center gap-1">
        <span>✨</span> ¡Tu pequeña acción ayuda a mantener limpio nuestro río Huallaga!
    </p>

    <input type="file" id="file-input" accept="image/*" class="hidden">

    <!-- Estado Inicial: Dropzone + Nota de la primera captura -->
    <div id="upload-initial-box" class="w-full flex flex-col items-center">
        <!-- Nota previa recordatoria de la captura -->
        <div class="w-full bg-amber-50 border border-amber-300 rounded-xl py-1.5 px-3 mb-2.5 text-center shadow-xs flex items-center justify-center gap-1.5">
            <span class="text-sm">📸</span>
            <span class="font-black text-amber-900 text-[11px] sm:text-xs">
                Recuerda: deberás tomar captura de tu foto y de tu puntaje final.
            </span>
        </div>

        <!-- Dropzone -->
        <div id="upload-dropzone" class="w-full border-2 border-dashed border-slate-300 rounded-2xl p-4 sm:p-5 hover:border-emerald-500 hover:bg-emerald-50/40 transition-all cursor-pointer flex flex-col items-center justify-center bg-white/70 shadow-sm">
            <div class="text-emerald-500 text-3xl mb-1"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <h3 class="font-black text-xs sm:text-sm text-slate-700">Toca o arrastra tu foto aquí</h3>
            <p class="text-slate-500 text-[10px] sm:text-[11px] mt-0.5">PNG, JPG — Máximo 5MB</p>
        </div>
    </div>

    <!-- Loading (Validación con IA) -->
    <div id="upload-loading" class="hidden w-full p-5 flex-col items-center justify-center bg-white/80 rounded-2xl border border-slate-200">
        <div class="spinner mb-2"></div>
        <p class="font-black text-xs sm:text-sm text-slate-700">Analizando foto con IA...</p>
        <span class="text-slate-500 text-[10px] sm:text-[11px] mt-0.5">Verificando acción ecológica o reciclaje</span>
    </div>

    <!-- Error (Mensaje exacto: "Sube la foto indicada.") -->
    <div id="upload-error" class="hidden w-full border-2 border-rose-300 bg-rose-50 p-3 rounded-2xl text-left shadow-sm mb-1">
        <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-circle-xmark text-rose-500 text-xl mt-0.5 shrink-0"></i>
            <div>
                <h4 class="font-black text-rose-800 text-xs sm:text-sm">Foto no válida</h4>
                <p id="upload-error-text" class="text-rose-700 text-xs font-bold my-1 leading-snug">
                    Sube la foto indicada.
                </p>
                <button id="btn-retry-upload" class="bg-white text-rose-700 font-black text-xs py-1 px-2.5 rounded-lg border border-rose-300 shadow-sm active:scale-95 transition-transform mt-0.5 cursor-pointer">
                    Intentar de nuevo
                </button>
            </div>
        </div>
    </div>

    <!-- Estado Éxito: Preview + Alerta de 1era Captura + Botón Iniciar desafío -->
    <div id="upload-success" class="hidden w-full flex-col items-center">
        <!-- Preview de la foto con insignia -->
        <div class="w-full h-22 sm:h-26 bg-emerald-100 border-2 border-emerald-400 rounded-xl flex items-center justify-center mb-1.5 overflow-hidden relative shadow-sm">
            <img id="preview-img" class="w-full h-full object-cover opacity-60" src="" alt="preview">
            <div class="absolute inset-0 flex items-center justify-center flex-col text-emerald-950 drop-shadow-sm">
                <i class="fa-solid fa-check-circle text-2xl sm:text-3xl mb-0.5 text-emerald-600"></i>
                <span class="font-black text-xs sm:text-sm">Evidencia aceptada</span>
            </div>
        </div>

        <!-- Alerta de captura obligatoria de la foto -->
        <div class="w-full bg-amber-50 border border-amber-300 rounded-xl py-1.5 px-2.5 mb-2 text-left shadow-sm flex items-center gap-2">
            <span class="text-xl shrink-0">📸</span>
            <div>
                <h4 class="font-black text-amber-900 text-[11px] sm:text-xs leading-tight">¡No olvides tomar una captura de tu fotografía!</h4>
                <p class="text-amber-800 text-[10px] sm:text-[11px] font-bold mt-0.5 leading-tight">
                    Guárdala para luego reclamar tu Insignia de Eco-Explorador junto con tu puntuación final.
                </p>
            </div>
        </div>

        <button id="btn-start-game" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black text-sm sm:text-base py-2.5 rounded-xl border-b-4 border-emerald-700 shadow-md active:border-b-2 active:translate-y-1 transition-all mb-1 cursor-pointer">
            Iniciar desafío
        </button>

        <button id="btn-change-image" class="text-slate-500 hover:text-slate-700 font-bold text-xs py-0.5 transition-colors flex items-center gap-1 cursor-pointer">
            <i class="fa-solid fa-arrows-rotate text-[10px]"></i> Cambiar foto
        </button>
    </div>
</section>
