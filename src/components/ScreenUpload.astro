---
---

<section id="screen-upload" class="relative z-10 w-[90%] max-w-xl glass-panel rounded-[2rem] p-8 text-center hidden flex-col items-center">
    <h2 class="text-2xl md:text-3xl font-black text-slate-800 mb-2">Demuestra tu compromiso</h2>
    <p class="text-slate-600 text-sm md:text-base font-semibold mb-6">Sube una foto cuidando el ambiente. <br><span class="text-red-500">*No se acepta reciclaje ni basura.</span></p>

    <input type="file" id="file-input" accept="image/*" class="hidden">

    <!-- Dropzone -->
    <div id="upload-dropzone" class="w-full border-4 border-dashed border-slate-300 rounded-3xl p-8 hover:border-blue-500 hover:bg-blue-50/50 transition-all cursor-pointer flex flex-col items-center justify-center bg-white/50">
        <div class="text-blue-500 text-4xl mb-3"><i class="fa-solid fa-cloud-arrow-up"></i></div>
        <h3 class="font-bold text-xl text-slate-700">Toca o arrastra tu foto aquí</h3>
        <p class="text-slate-500 text-sm mt-1">PNG, JPG — Máximo 5MB</p>
    </div>

    <!-- Loading -->
    <div id="upload-loading" class="hidden w-full p-8 flex-col items-center justify-center bg-white/50 rounded-3xl">
        <div class="spinner mb-3"></div>
        <p class="font-bold text-slate-600">Analizando imagen con IA...</p>
    </div>

    <!-- Error (Rejection) -->
    <div id="upload-error" class="hidden w-full border-2 border-red-300 bg-red-50 p-5 rounded-2xl text-left mt-2 shadow-sm">
        <div class="flex items-start gap-3">
            <i class="fa-solid fa-circle-xmark text-red-500 text-2xl mt-0.5"></i>
            <div>
                <h4 class="font-black text-red-700 text-lg">Imagen no válida</h4>
                <p class="text-red-600 text-sm font-semibold mb-3">
                    No se aceptan fotos de reciclaje, plásticos o basura en este desafío. Sube una evidencia relacionada al cuidado del agua o naturaleza.
                </p>
                <button id="btn-retry-upload" class="bg-white text-red-600 font-bold py-2 px-4 rounded-xl border border-red-200 shadow-sm active:scale-95 transition-transform">
                    Intentar de nuevo
                </button>
            </div>
        </div>
    </div>

    <!-- Success -->
    <div id="upload-success" class="hidden w-full flex-col items-center mt-2">
        <div class="w-full h-40 bg-emerald-100 border-4 border-emerald-400 rounded-2xl flex items-center justify-center mb-4 overflow-hidden relative">
            <img id="preview-img" class="w-full h-full object-cover opacity-50" src="" alt="preview">
            <div class="absolute inset-0 flex items-center justify-center flex-col text-emerald-800 drop-shadow-md">
                <i class="fa-solid fa-check-circle text-4xl mb-1"></i>
                <span class="font-black">Evidencia aceptada</span>
            </div>
        </div>
        <button id="btn-change-image" class="w-full bg-white text-slate-600 font-bold py-3 rounded-2xl border-2 border-slate-300 mb-3 active:scale-95 transition-transform flex justify-center items-center gap-2">
            <i class="fa-solid fa-arrows-rotate"></i> Cambiar imagen
        </button>
        <button id="btn-start-game" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black text-xl py-4 rounded-2xl shadow-[0_8px_0_rgb(4,120,87)] active:shadow-[0_0px_0_rgb(4,120,87)] active:translate-y-2 transition-all">
            Iniciar desafío
        </button>
    </div>
</section>
